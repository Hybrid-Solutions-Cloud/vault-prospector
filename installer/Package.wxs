<?xml version="1.0" encoding="utf-8"?>
<Wix
  xmlns="http://wixtoolset.org/schemas/v4/wxs"
  xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
    Name="Vault Prospector"
    Manufacturer="Hybrid Solutions Cloud"
    Version="$(MsiVersion)"
    UpgradeCode="{6E0981B0-6AD5-4B72-8ACA-ECEE660951B2}"
    Language="1033"
    Scope="perMachine"
    Compressed="yes">

    <SummaryInformation Description="Vault Prospector Windows desktop application" />
    <MajorUpgrade
      Schedule="afterInstallInitialize"
      DowngradeErrorMessage="A newer version of Vault Prospector is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="VaultProspector.ico" SourceFile="..\src\VaultProspector.App\Assets\vault-prospector.ico" />
    <Property Id="ARPPRODUCTICON" Value="VaultProspector.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/Hybrid-Solutions-Cloud/vault-prospector-releases" />
    <Property Id="ARPCONTACT" Value="Hybrid Solutions Cloud" />
    <WixVariable Id="WixUILicenseRtf" Value="$(sys.SOURCEFILEDIR)Assets\License.rtf" />
    <WixVariable Id="WixUIDialogBmp" Value="$(sys.SOURCEFILEDIR)Assets\AtlasDialog.bmp" />
    <WixVariable Id="WixUIBannerBmp" Value="$(sys.SOURCEFILEDIR)Assets\AtlasBanner.bmp" />
    <Property
      Id="WIXUI_EXITDIALOGOPTIONALTEXT"
      Value="Updates and reinstalls preserve encrypted local state for this Windows account." />
    <Property
      Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT"
      Value="Launch Vault Prospector" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Vault Prospector" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Vault Prospector" />
    </StandardDirectory>

    <Component Id="MainExecutable" Directory="INSTALLFOLDER" Guid="{B271A5FE-AEA5-4C2D-9765-EFEFDD7047E3}">
      <File Id="MainExecutableFile" Source="$(PublishDirectory)\VaultProspector.App.exe" KeyPath="yes">
        <Shortcut
          Id="VaultProspectorStartMenuShortcut"
          Directory="ApplicationProgramsFolder"
          Name="Vault Prospector"
          Description="Search Azure Key Vault metadata securely"
          Icon="VaultProspector.ico"
          IconIndex="0"
          WorkingDirectory="INSTALLFOLDER"
          Advertise="yes" />
      </File>
      <RemoveFolder Id="RemoveApplicationProgramsFolder" Directory="ApplicationProgramsFolder" On="uninstall" />
    </Component>

    <ComponentGroup Id="ProductFiles" Directory="INSTALLFOLDER">
      <Files Include="$(PublishDirectory)\**">
        <Exclude Files="$(PublishDirectory)\**\*.pdb" />
        <Exclude Files="$(PublishDirectory)\VaultProspector.App.exe" />
      </Files>
    </ComponentGroup>

    <Component
      Id="BrowserNativeMessagingRegistration"
      Directory="INSTALLFOLDER"
      Guid="{B407253B-3A80-4F50-BC67-F99C48EAA0C9}">
      <RegistryValue
        Root="HKLM"
        Key="SOFTWARE\Google\Chrome\NativeMessagingHosts\com.hybridsolutionscloud.vaultprospector"
        Type="string"
        Value="[INSTALLFOLDER]BrowserHost\com.hybridsolutionscloud.vaultprospector.chromium.json"
        KeyPath="yes" />
      <RegistryValue
        Root="HKLM"
        Key="SOFTWARE\Microsoft\Edge\NativeMessagingHosts\com.hybridsolutionscloud.vaultprospector"
        Type="string"
        Value="[INSTALLFOLDER]BrowserHost\com.hybridsolutionscloud.vaultprospector.chromium.json" />
      <RegistryValue
        Root="HKLM"
        Key="SOFTWARE\Mozilla\NativeMessagingHosts\com.hybridsolutionscloud.vaultprospector"
        Type="string"
        Value="[INSTALLFOLDER]BrowserHost\com.hybridsolutionscloud.vaultprospector.firefox.json" />
    </Component>

    <Feature Id="MainFeature" Title="Vault Prospector" Level="1">
      <ComponentGroupRef Id="ProductFiles" />
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="BrowserNativeMessagingRegistration" />
    </Feature>

    <ui:WixUI
      Id="WixUI_InstallDir"
      InstallDirectory="INSTALLFOLDER" />
    <UIRef Id="WixUI_ErrorProgressText" />

    <CustomAction
      Id="LaunchVaultProspector"
      FileRef="MainExecutableFile"
      ExeCommand=""
      Execute="immediate"
      Impersonate="yes"
      Return="asyncNoWait" />

    <UI>
      <Publish
        Dialog="ExitDialog"
        Control="Finish"
        Event="DoAction"
        Value="LaunchVaultProspector"
        Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
  </Package>
</Wix>
