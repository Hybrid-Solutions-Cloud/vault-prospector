<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VaultProspector.App.ViewModels"
        x:Class="VaultProspector.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1440" Height="860" MinWidth="320" MinHeight="300"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/vault-prospector.ico"
        Title="Vault Prospector">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Background="{DynamicResource VaultColorCanvas}">
    <Border Grid.Row="0" Background="{DynamicResource VaultColorHeader}">
      <Grid RowDefinitions="Auto,Auto">
        <Grid ColumnDefinitions="*,Auto" Margin="18,10">
          <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <Border Width="38" Height="38" Background="White" CornerRadius="4" Padding="3">
              <Image Source="/Assets/vault-prospector.png"
                     Stretch="Uniform"
                     AutomationProperties.Name="Vault Prospector logo" />
            </Border>
            <StackPanel>
              <TextBlock Text="Vault Prospector" Foreground="White" FontSize="{StaticResource VaultFontSize18}" FontWeight="SemiBold" />
              <TextBlock Text="Secure Azure retrieval" Foreground="#AEB9B5" FontSize="{StaticResource VaultFontSize11}" />
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Border x:Name="HeaderContextBadge" BorderBrush="#667170" BorderThickness="1" Padding="12,7">
              <TextBlock Text="LOCAL-FIRST · READ-ONLY BY DEFAULT" Foreground="#E7ECEA" FontSize="{StaticResource VaultFontSize11}" FontWeight="SemiBold" />
            </Border>
            <Button Classes="header-action"
                    Content="Lock now"
                    Command="{Binding LockNowCommand}"
                    IsVisible="{Binding IsUnlocked}"
                    AutomationProperties.Name="Lock Vault Prospector now" />
          </StackPanel>
        </Grid>
        <Border Grid.Row="1" Background="{DynamicResource VaultColorContext}" BorderBrush="{DynamicResource VaultColorLine}" BorderThickness="0,1,0,0" Padding="20,9">
          <Grid x:Name="ActiveContextGrid"
                ColumnDefinitions="Auto,Auto,*,Auto"
                RowDefinitions="Auto"
                ColumnSpacing="16"
                RowSpacing="6">
            <TextBlock x:Name="ActiveContextLabel"
                       Text="ACTIVE WORKSPACE"
                       Foreground="{DynamicResource VaultColorMuted}"
                       FontSize="{StaticResource VaultFontSize11}"
                       FontWeight="Bold"
                       VerticalAlignment="Center" />
            <Border x:Name="ActiveWorkspaceBadge"
                    Grid.Column="1"
                    Background="{DynamicResource VaultColorSurface}"
                    BorderBrush="{DynamicResource VaultColorLineStrong}"
                    BorderThickness="1"
                    Padding="10,6">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Width="7" Background="#1A9B83" />
                <TextBlock Text="{Binding ActiveWorkspaceContext}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
              </StackPanel>
            </Border>
            <Border x:Name="ActiveReadyBadge"
                    Grid.Column="3"
                    IsVisible="{Binding IsApplicationReady}"
                    Background="{DynamicResource VaultColorGoodSoft}"
                    BorderBrush="{DynamicResource VaultColorGood}"
                    BorderThickness="1"
                    Padding="10,5">
              <TextBlock Text="READY"
                         Foreground="{DynamicResource VaultColorGood}"
                         FontSize="{StaticResource VaultFontSize11}"
                         FontWeight="Bold" />
            </Border>
          </Grid>
        </Border>
      </Grid>
    </Border>

    <Border Grid.Row="1" IsVisible="{Binding HasActionableError}" Background="#3F1616" BorderBrush="#DC6B6B" BorderThickness="1" CornerRadius="6" Margin="18,12,18,0" Padding="14" AutomationProperties.Name="{Binding ErrorAnnouncement}" AutomationProperties.LiveSetting="Assertive">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
        <TextBlock Text="!" FontSize="{StaticResource VaultFontSize22}" FontWeight="Bold" Foreground="#FCA5A5" />
        <StackPanel Grid.Column="1" Spacing="4">
          <TextBlock Text="{Binding ErrorTitle}" FontSize="{StaticResource VaultFontSize16}" FontWeight="SemiBold" Foreground="White" />
          <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="White" />
          <TextBlock Text="{Binding RecoveryText}" TextWrapping="Wrap" Foreground="#FECACA" FontWeight="SemiBold" />
          <Button x:Name="ActionableErrorAnnouncementTarget" Content="Return to previous action" Click="ActionableErrorAnnouncementTarget_OnClick" AutomationProperties.Name="{Binding ErrorAnnouncement}" Background="#FECACA" Foreground="#3F1616" HorizontalAlignment="Left" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="2" Margin="18" Classes="card" IsVisible="{Binding IsLocalDataBlocked}" MaxWidth="680" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel Spacing="16">
        <TextBlock Text="{Binding LocalDataFailureTitle}" FontSize="{StaticResource VaultFontSize24}" FontWeight="Bold" Foreground="#FCA5A5" />
        <TextBlock Text="{Binding LocalDataRecoveryGuidance}" TextWrapping="Wrap" />
        <StackPanel IsVisible="{Binding CanResetLocalData}" Spacing="10">
          <TextBlock Text="This operation archives the database, Windows-protected keys, offline values, identity cache, settings, and logs together. It does not delete or silently replace the failed state." TextWrapping="Wrap" Opacity="0.8" />
          <TextBlock Text="Type RESET to confirm that you want to archive this local state and start fresh." TextWrapping="Wrap" FontWeight="SemiBold" />
          <TextBox Text="{Binding ResetConfirmation}" PlaceholderText="RESET" AutomationProperties.Name="Local data reset confirmation" />
          <Button Classes="primary"
                  Background="#DC2626"
                  Content="Verify and archive local data"
                  Command="{Binding ArchiveAndResetLocalDataCommand}"
                  AutomationProperties.Name="Verify and archive local Vault Prospector data"
                  HorizontalAlignment="Left" />
        </StackPanel>
        <StackPanel IsVisible="{Binding IsRecoveryComplete}" Spacing="8">
          <TextBlock Text="Encrypted local state was archived. Close and reopen Vault Prospector to create fresh state, then reconnect Azure identities." TextWrapping="Wrap" FontWeight="SemiBold" />
          <TextBlock Text="{Binding RecoveryArchivePath, StringFormat='Recovery archive: {0}'}" TextWrapping="Wrap" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Grid x:Name="UnlockShellGrid"
          Grid.Row="2"
          ColumnDefinitions="220,*"
          RowDefinitions="*"
          IsVisible="{Binding !IsUnlocked}">
      <Border x:Name="UnlockNavigation"
              Background="{DynamicResource VaultColorNavigation}"
              BorderBrush="{DynamicResource VaultColorLine}"
              BorderThickness="0,0,1,0">
        <Grid RowDefinitions="*,Auto">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="18,22" Spacing="8">
              <TextBlock Text="WORKSPACE TOOLS"
                         Foreground="{DynamicResource VaultColorMuted}"
                         FontSize="{StaticResource VaultFontSize11}"
                         FontWeight="Bold"
                         LetterSpacing="1.2" />
              <TextBlock Text="START"
                         Margin="0,12,0,2"
                         Foreground="{DynamicResource VaultColorMuted}"
                         FontSize="{StaticResource VaultFontSize11}"
                         FontWeight="Bold"
                         LetterSpacing="1.2" />
              <Border Background="{DynamicResource VaultColorAccent}"
                      BorderBrush="{DynamicResource VaultColorAccentStrong}"
                      BorderThickness="5,0,0,0"
                      Padding="13,11"
                      AutomationProperties.Name="Secure unlock, selected">
                <TextBlock Text="◉  Secure unlock"
                           Foreground="White"
                           FontSize="{StaticResource VaultFontSize16}"
                           FontWeight="SemiBold" />
              </Border>
              <TextBlock Text="◎  Connect identities"
                         Margin="13,8,0,0"
                         FontSize="{StaticResource VaultFontSize16}"
                         Opacity="0.55" />
              <TextBlock Text="↻  Sync and health"
                         Margin="13,8,0,0"
                         FontSize="{StaticResource VaultFontSize16}"
                         Opacity="0.55" />
              <TextBlock Text="USE"
                         Margin="0,16,0,2"
                         Foreground="{DynamicResource VaultColorMuted}"
                         FontSize="{StaticResource VaultFontSize11}"
                         FontWeight="Bold"
                         LetterSpacing="1.2" />
              <TextBlock Text="⌕  Find secrets"
                         Margin="13,8,0,0"
                         FontSize="{StaticResource VaultFontSize16}"
                         Opacity="0.55" />
              <TextBlock Text="◉  Reveal safely"
                         Margin="13,8,0,0"
                         FontSize="{StaticResource VaultFontSize16}"
                         Opacity="0.55" />
              <TextBlock Text="▣  Workspaces"
                         Margin="13,8,0,0"
                         FontSize="{StaticResource VaultFontSize16}"
                         Opacity="0.55" />
              <TextBlock Text="◎  Browser fill"
                         Margin="13,8,0,0"
                         FontSize="{StaticResource VaultFontSize16}"
                         Opacity="0.55" />
              <TextBlock Text="MANAGE"
                         Margin="0,16,0,2"
                         Foreground="{DynamicResource VaultColorMuted}"
                         FontSize="{StaticResource VaultFontSize11}"
                         FontWeight="Bold"
                         LetterSpacing="1.2" />
              <TextBlock Text="⚙  Administration"
                         Margin="13,8,0,0"
                         FontSize="{StaticResource VaultFontSize16}"
                         Opacity="0.55" />
              <TextBlock Text="⌁  Activity and support"
                         Margin="13,8,0,0"
                         FontSize="{StaticResource VaultFontSize16}"
                         TextWrapping="Wrap"
                         Opacity="0.55" />
              <TextBlock Text="⚙  Settings and updates"
                         Margin="13,8,0,0"
                         FontSize="{StaticResource VaultFontSize16}"
                         TextWrapping="Wrap"
                         Opacity="0.55" />
            </StackPanel>
          </ScrollViewer>
          <Border Grid.Row="1"
                  Margin="18"
                  Padding="0,12,0,0"
                  BorderBrush="{DynamicResource VaultColorLine}"
                  BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Border Width="9"
                      Height="9"
                      CornerRadius="5"
                      Background="{DynamicResource VaultColorWarning}"
                      VerticalAlignment="Top"
                      Margin="0,3,0,0" />
              <StackPanel>
                <TextBlock Text="Locked securely" FontWeight="SemiBold" />
                <TextBlock Text="Verification required"
                           FontSize="{StaticResource VaultFontSize11}"
                           Foreground="{DynamicResource VaultColorMuted}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <ScrollViewer x:Name="UnlockContent"
                    Grid.Column="1"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="38,30,38,24" Spacing="20">
          <StackPanel Spacing="6">
            <TextBlock Classes="screen-eyebrow" Text="LOCAL PROTECTION" />
            <TextBlock Classes="screen-title" Text="Unlock this installation" />
            <TextBlock Classes="screen-description"
                       Text="Windows verifies that you are present before Vault Prospector opens its encrypted local data." />
          </StackPanel>

          <Grid x:Name="UnlockExperienceGrid"
                ColumnDefinitions="1.05*,0.95*"
                RowDefinitions="*"
                ColumnSpacing="24"
                RowSpacing="24">
            <Border Padding="28"
                    Background="{DynamicResource VaultColorSurfaceAlt}"
                    BorderBrush="{DynamicResource VaultColorLine}"
                    BorderThickness="1">
              <StackPanel Spacing="18"
                          VerticalAlignment="Center">
                <Border Width="82"
                        Height="82"
                        CornerRadius="42"
                        Background="{DynamicResource VaultColorGoodSoft}"
                        BorderBrush="{DynamicResource VaultColorGood}"
                        BorderThickness="1"
                        HorizontalAlignment="Left">
                  <TextBlock Text="◎"
                             Foreground="{DynamicResource VaultColorGood}"
                             FontSize="{StaticResource VaultFontSize24}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Your Azure identities are separate"
                           FontSize="{StaticResource VaultFontSize24}"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <TextBlock Text="Unlocking opens encrypted data for this Windows account. It does not sign you into Azure, and you can connect multiple Microsoft Entra identities afterward."
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource VaultColorMuted}" />
              </StackPanel>
            </Border>

            <Border x:Name="UnlockVerificationCard"
                    Grid.Column="1"
                    Classes="card"
                    Padding="24">
              <StackPanel Spacing="14">
                <Border Background="{DynamicResource VaultColorGoodSoft}"
                        BorderBrush="{DynamicResource VaultColorGood}"
                        BorderThickness="1"
                        Padding="12">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <TextBlock Text="▣"
                               FontSize="{StaticResource VaultFontSize18}"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="Windows session detected"
                                 FontWeight="SemiBold" />
                      <TextBlock Text="Current Windows account · interactive session"
                                 FontSize="{StaticResource VaultFontSize11}"
                                 Foreground="{DynamicResource VaultColorMuted}"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock Grid.Column="2"
                               Text="SUPPORTED"
                               Foreground="{DynamicResource VaultColorGood}"
                               FontSize="{StaticResource VaultFontSize11}"
                               FontWeight="Bold"
                               VerticalAlignment="Center" />
                  </Grid>
                </Border>

                <TextBlock Text="Verification method"
                           FontWeight="SemiBold" />
                <Border Background="{DynamicResource VaultColorAccentSoft}"
                        BorderBrush="{DynamicResource VaultColorAccent}"
                        BorderThickness="1"
                        Padding="12">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <TextBlock Text="◎"
                               FontSize="{StaticResource VaultFontSize20}"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="Windows verification"
                                 FontWeight="SemiBold" />
                      <TextBlock Text="Windows Hello locally, or the administrator-approved current-account credential prompt in a supported AVD or Remote Desktop session."
                                 TextWrapping="Wrap"
                                 FontSize="{StaticResource VaultFontSize12}" />
                    </StackPanel>
                  </Grid>
                </Border>

                <Border Background="{DynamicResource VaultColorSurfaceAlt}"
                        BorderBrush="{DynamicResource VaultColorLine}"
                        BorderThickness="1"
                        Padding="12">
                  <StackPanel Spacing="4">
                    <TextBlock Text="Remote sessions do not bypass verification"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Vault Prospector selects only the verification method allowed for this Windows session and enterprise policy."
                               TextWrapping="Wrap"
                               FontSize="{StaticResource VaultFontSize12}" />
                  </StackPanel>
                </Border>

                <TextBlock Text="{Binding UnlockMessage}"
                           TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite" />
                <TextBlock Text="{Binding UnlockRecovery}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource VaultColorMuted}" />
                <Button Classes="primary"
                        Content="Verify and continue"
                        Command="{Binding InitializeCommand}"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Verify and unlock Vault Prospector" />
                <TextBlock Text="Windows controls the verification prompt. Vault Prospector never receives your Windows password, PIN, face, or fingerprint."
                           TextWrapping="Wrap"
                           FontSize="{StaticResource VaultFontSize11}"
                           Opacity="0.72" />
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <Border Grid.Row="2"
            ZIndex="20"
            IsVisible="{Binding IsCloseChoiceVisible}"
            Background="#E80B1713"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            AutomationProperties.Name="Choose what Vault Prospector does when the window closes">
      <Border Classes="card"
              MaxWidth="560"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Margin="20">
        <StackPanel Spacing="14">
          <TextBlock Text="Close Vault Prospector" FontSize="{StaticResource VaultFontSize24}" FontWeight="Bold" />
          <TextBlock Text="Choose explicitly. Continuing in the notification area immediately hides any revealed value and locks foreground access. Exiting clears an unchanged app-owned clipboard value and stops background work." TextWrapping="Wrap" />
          <Button Classes="primary"
                  Content="Lock and continue in notification area"
                  Command="{Binding ContinueInBackgroundCommand}"
                  AutomationProperties.Name="Lock Vault Prospector and continue metadata-only work in notification area" />
          <Button Content="Exit Vault Prospector"
                  Command="{Binding RequestExitCommand}"
                  AutomationProperties.Name="Exit Vault Prospector and clear temporary sensitive state" />
          <Button Content="Cancel"
                  Command="{Binding CancelCloseCommand}"
                  AutomationProperties.Name="Cancel closing Vault Prospector" />
        </StackPanel>
      </Border>
    </Border>

    <TabControl x:Name="MainTabs"
                Grid.Row="2"
                Classes="product-shell"
                TabStripPlacement="Left"
                Margin="0"
                IsVisible="{Binding IsApplicationReady}"
                SelectedIndex="{Binding SelectedMainTabIndex}">
      <TabItem Header="⌕  Find secrets">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="38,30,38,24" Spacing="14">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
            <StackPanel Spacing="6">
              <TextBlock Classes="screen-eyebrow" Text="ENCRYPTED LOCAL INDEX" />
              <TextBlock Classes="screen-title" Text="Find a vault object" />
              <TextBlock Classes="screen-description"
                         Text="Search synchronized metadata across your identities and workspaces. Values are retrieved only when requested." />
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
              <TextBlock Text="⌁  Index current"
                         Foreground="{DynamicResource VaultColorGood}"
                         FontSize="{StaticResource VaultFontSize16}"
                         FontWeight="Bold" />
              <TextBlock Text="{Binding Results.Count, StringFormat={}{0} objects available}"
                         Foreground="{DynamicResource VaultColorMuted}"
                         FontSize="{StaticResource VaultFontSize11}"
                         HorizontalAlignment="Right" />
            </StackPanel>
          </Grid>
          <Border Classes="atlas-panel">
            <StackPanel Spacing="10">
              <Grid x:Name="SearchCommandGrid" ColumnDefinitions="*,Auto" ColumnSpacing="10" RowSpacing="8">
                <TextBox x:Name="SearchTextBox"
                         Classes="atlas-search"
                         PlaceholderText="Search names, tags, vaults, or subscriptions"
                         Text="{Binding SearchText}"
                         KeyUp="SearchBox_OnKeyUp"
                         AutomationProperties.Name="Search vault metadata" />
                <Button x:Name="SearchButton"
                        Grid.Column="1"
                        Classes="primary"
                        Content="Search"
                        Command="{Binding SearchCommand}"
                        AutomationProperties.Name="Search vault metadata" />
              </Grid>
              <WrapPanel Orientation="Horizontal">
                <CheckBox Content="Favorites" IsChecked="{Binding FavoritesOnly}" Margin="0,0,14,6" />
                <CheckBox Content="Stale" IsChecked="{Binding StaleOnly}" Margin="0,0,14,6" />
                <CheckBox Content="Enabled" IsChecked="{Binding EnabledOnly}" Margin="0,0,14,6" />
                <CheckBox Content="Expired" IsChecked="{Binding ExpiredOnly}" Margin="0,0,14,6" />
                <CheckBox Content="Selected identity" IsChecked="{Binding FilterSelectedIdentity}" IsEnabled="{Binding HasSelectedIdentity}" Margin="0,0,14,6" />
                <CheckBox Content="Selected workspace" IsChecked="{Binding FilterSelectedWorkspace}" IsEnabled="{Binding HasSelectedWorkspace}" Margin="0,0,14,6" />
                <CheckBox Content="Recent first" IsChecked="{Binding RecentlyAccessedFirst}" Margin="0,0,14,6" />
              </WrapPanel>
              <Grid x:Name="SearchFilterGrid" ColumnDefinitions="150,*,*,*,*" ColumnSpacing="10" RowSpacing="8">
                <StackPanel x:Name="ObjectTypeFilterPanel" Spacing="4">
                  <TextBlock Classes="field-label" Text="Object type" />
                  <ComboBox x:Name="ObjectTypeComboBox"
                            Classes="atlas-filter"
                            ItemsSource="{Binding ObjectTypes}"
                            SelectedItem="{Binding SelectedObjectType}"
                            AutomationProperties.Name="Object type filter" />
                </StackPanel>
                <StackPanel x:Name="TenantFilterPanel" Grid.Column="1" Spacing="4">
                  <TextBlock Classes="field-label" Text="Tenant" />
                  <ComboBox x:Name="TenantFilterComboBox"
                            Classes="atlas-filter"
                            ItemsSource="{Binding TenantFilterOptions}"
                            SelectedItem="{Binding SelectedTenantFilterOption}"
                            AutomationProperties.Name="Tenant filter">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:SearchFilterOption"><TextBlock Text="{Binding Label}" /></DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
                <StackPanel x:Name="SubscriptionFilterPanel" Grid.Column="2" Spacing="4">
                  <TextBlock Classes="field-label" Text="Subscription" />
                  <ComboBox x:Name="SubscriptionFilterComboBox"
                            Classes="atlas-filter"
                            ItemsSource="{Binding SubscriptionFilterOptions}"
                            SelectedItem="{Binding SelectedSubscriptionFilterOption}"
                            AutomationProperties.Name="Subscription filter">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:SearchFilterOption"><TextBlock Text="{Binding Label}" /></DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
                <StackPanel x:Name="VaultFilterPanel" Grid.Column="3" Spacing="4">
                  <TextBlock Classes="field-label" Text="Vault" />
                  <ComboBox x:Name="VaultFilterComboBox"
                            Classes="atlas-filter"
                            ItemsSource="{Binding VaultFilterOptions}"
                            SelectedItem="{Binding SelectedVaultFilterOption}"
                            AutomationProperties.Name="Vault filter">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:SearchFilterOption"><TextBlock Text="{Binding Label}" /></DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
                <StackPanel x:Name="ScopeFilterPanel" Grid.Column="4" Spacing="4">
                  <TextBlock Classes="field-label" Text="Scope" />
                  <Button Content="Reset filters"
                          MinHeight="40"
                          Command="{Binding SearchCommand}" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>
          <Grid x:Name="SearchResultsGrid" Grid.Row="1" ColumnDefinitions="2.2*,1*" RowDefinitions="*" MinHeight="360" ColumnSpacing="14" RowSpacing="14">
            <Border Classes="atlas-panel" Padding="0">
              <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
              <Grid RowDefinitions="Auto,Auto,*" MinWidth="650">
                <Grid Margin="14,12" ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="{Binding Results.Count, StringFormat={}{0} results}"
                               FontSize="{StaticResource VaultFontSize16}"
                               FontWeight="Bold" />
                    <TextBlock Text="Workspace: all accessible sources"
                               Foreground="{DynamicResource VaultColorMuted}"
                               FontSize="{StaticResource VaultFontSize11}" />
                  </StackPanel>
                  <TextBlock Grid.Column="1"
                             Text="Metadata only"
                             Foreground="{DynamicResource VaultColorGood}"
                             FontWeight="SemiBold"
                             VerticalAlignment="Center" />
                </Grid>
                <Grid Grid.Row="1" ColumnDefinitions="36,2*,120,160,120" Margin="8,0,8,8" Background="{DynamicResource VaultColorSurfaceAlt}">
                  <TextBlock Text="" /><TextBlock Grid.Column="1" Text="NAME" FontWeight="Bold" FontSize="{StaticResource VaultFontSize11}" />
                  <TextBlock Grid.Column="2" Text="TYPE" FontWeight="Bold" FontSize="{StaticResource VaultFontSize11}" />
                  <TextBlock Grid.Column="3" Text="VAULT" FontWeight="Bold" FontSize="{StaticResource VaultFontSize11}" />
                  <TextBlock Grid.Column="4" Text="STATE" FontWeight="Bold" FontSize="{StaticResource VaultFontSize11}" />
                </Grid>
                <ListBox Grid.Row="2"
                         Classes="atlas-list"
                         ItemsSource="{Binding Results}"
                         SelectedItem="{Binding SelectedResult}"
                         MaxHeight="520"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Visible"
                         AutomationProperties.Name="Vault search results">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SearchResultRow">
                      <Grid ColumnDefinitions="36,2*,120,160,120" Margin="6,8">
                        <TextBlock Text="{Binding FavoriteMarker}" Foreground="#E3A008" />
                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Text="{Binding Type}" />
                        <TextBlock Grid.Column="3" Text="{Binding Vault}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="4" Text="{Binding State}" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
              </ScrollViewer>
            </Border>
            <Border x:Name="SelectedObjectCard" Grid.Column="1" Classes="atlas-panel">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="10">
                <Border Width="42" Height="42" Background="{DynamicResource VaultColorAccentSoft}" HorizontalAlignment="Left">
                  <TextBlock Text="⌘" Foreground="{DynamicResource VaultColorAccent}" FontSize="{StaticResource VaultFontSize22}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="SECRET" Classes="screen-eyebrow" />
                <TextBlock Text="{Binding SelectedResult.Name, FallbackValue=Nothing selected}" FontSize="{StaticResource VaultFontSize20}" AutomationProperties.Name="Selected object name" />
                <TextBlock Text="{Binding SelectedResult.Vault, StringFormat='Vault  {0}'}" Opacity="0.75" AutomationProperties.Name="Selected object vault" />
                <TextBlock Text="{Binding SelectedResult.Identity, StringFormat='Identity  {0}'}" Opacity="0.75" AutomationProperties.Name="Selected object identity" />
                <TextBlock Text="{Binding SelectedResult.Tenant, StringFormat='Tenant  {0}'}" Opacity="0.75" TextWrapping="Wrap" AutomationProperties.Name="Selected object tenant" />
                <TextBlock Text="{Binding SelectedResult.AccessStatus}" Opacity="0.75" TextWrapping="Wrap" AutomationProperties.Name="Selected object effective permission assessment" />
                <Border Classes="atlas-callout" Margin="0,8">
                  <TextBlock Text="{Binding SecretPreview}" FontFamily="Consolas" TextWrapping="Wrap" AutomationProperties.Name="Masked secret value" />
                </Border>
                <StackPanel Spacing="8">
                  <Button Classes="primary" Content="Reveal safely" Command="{Binding RevealCommand}" HorizontalAlignment="Stretch" />
                  <Button Content="Copy securely" Command="{Binding CopyCommand}" HorizontalAlignment="Stretch" />
                  <Button Content="Favorite" Command="{Binding ToggleFavoriteCommand}" Margin="0,0,8,8" />
                  <Button Content="Cache offline" Command="{Binding CacheSelectedCommand}" Margin="0,0,8,8" />
                  <Button Content="Open offline" Command="{Binding OpenOfflineCommand}" Margin="0,0,8,8" />
                  <Button Content="Purge offline copy" Command="{Binding PurgeSelectedCachedValueCommand}" Margin="0,0,8,8" />
                </StackPanel>
                <TextBlock Text="Values are retrieved only after explicit action and Windows Hello verification." FontSize="{StaticResource VaultFontSize11}" Opacity="0.7" TextWrapping="Wrap" />
              </StackPanel>
              </ScrollViewer>
            </Border>
          </Grid>
        </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="◎  Connect identities">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="38,30,38,24" Spacing="18">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
            <StackPanel Spacing="6">
              <TextBlock Classes="screen-eyebrow" Text="FIRST-RUN SETUP" />
              <TextBlock Classes="screen-title" Text="Connect the accounts you use" />
              <TextBlock Classes="screen-description"
                         Text="Add each Microsoft Entra account once. Guest memberships and accessible tenants are discovered after sign-in." />
            </StackPanel>
            <Border Grid.Column="1"
                    Background="{DynamicResource VaultColorGoodSoft}"
                    BorderBrush="{DynamicResource VaultColorGood}"
                    BorderThickness="1"
                    Padding="10,6"
                    VerticalAlignment="Top">
              <TextBlock Text="Local protection complete"
                         Foreground="{DynamicResource VaultColorGood}"
                         FontWeight="Bold" />
            </Border>
          </Grid>

          <Grid x:Name="SetupStepperGrid" ColumnDefinitions="*,*,*,*" ColumnSpacing="0">
            <Border x:Name="SetupProtectionStep" BorderBrush="{DynamicResource VaultColorAccent}" BorderThickness="0,3,0,0" Padding="12,12">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <Border Width="26" Height="26" Background="{DynamicResource VaultColorAccent}" CornerRadius="13">
                  <TextBlock Text="✓" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel>
                  <TextBlock Text="Local protection" FontWeight="Bold" />
                  <TextBlock Text="Complete" FontSize="{StaticResource VaultFontSize11}" Foreground="{DynamicResource VaultColorMuted}" />
                </StackPanel>
              </StackPanel>
            </Border>
            <Border x:Name="SetupConnectionsStep" Grid.Column="1" Background="{DynamicResource VaultColorAccentSoft}" BorderBrush="{DynamicResource VaultColorAccent}" BorderThickness="0,3,0,0" Padding="12,12">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <Border Width="26" Height="26" Background="{DynamicResource VaultColorAccent}" CornerRadius="13">
                  <TextBlock Text="{Binding SetupConnectionsMarker}" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel>
                  <TextBlock Text="Connect identities" FontWeight="Bold" />
                  <TextBlock Text="{Binding SetupConnectionsStatus}" FontSize="{StaticResource VaultFontSize11}" Foreground="{DynamicResource VaultColorMuted}" />
                </StackPanel>
              </StackPanel>
            </Border>
            <Border x:Name="SetupScopeStep" Grid.Column="2" BorderBrush="{DynamicResource VaultColorLine}" BorderThickness="0,3,0,0" Padding="12,12">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <Border Width="26" Height="26" Background="{DynamicResource VaultColorSurfaceAlt}" CornerRadius="13">
                  <TextBlock Text="{Binding SetupScopeMarker}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel>
                  <TextBlock Text="Choose discovery scope" FontWeight="Bold" Foreground="{DynamicResource VaultColorMuted}" />
                  <TextBlock Text="{Binding SetupScopeStatus}" FontSize="{StaticResource VaultFontSize11}" Foreground="{DynamicResource VaultColorMuted}" />
                </StackPanel>
              </StackPanel>
            </Border>
            <Border x:Name="SetupSyncStep" Grid.Column="3" BorderBrush="{DynamicResource VaultColorLine}" BorderThickness="0,3,0,0" Padding="12,12">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <Border Width="26" Height="26" Background="{DynamicResource VaultColorSurfaceAlt}" CornerRadius="13">
                  <TextBlock Text="{Binding SetupSyncMarker}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel>
                  <TextBlock Text="Synchronize metadata" FontWeight="Bold" Foreground="{DynamicResource VaultColorMuted}" />
                  <TextBlock Text="{Binding SetupSyncStatus}" FontSize="{StaticResource VaultFontSize11}" Foreground="{DynamicResource VaultColorMuted}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </Grid>

        <Grid x:Name="IdentityGrid" ColumnDefinitions="2.2*,1*" RowDefinitions="*" ColumnSpacing="18" RowSpacing="14">
          <Border Classes="atlas-panel">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Text="Connected identities" Classes="section-title" />
                  <TextBlock Text="{Binding Identities.Count, StringFormat={}{0} accounts ready}"
                             Foreground="{DynamicResource VaultColorMuted}"
                             FontSize="{StaticResource VaultFontSize12}" />
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Text="Select an account to manage its scope"
                           Foreground="{DynamicResource VaultColorMuted}"
                           VerticalAlignment="Center" />
              </Grid>
              <ListBox Classes="atlas-list"
                       ItemsSource="{Binding Identities}"
                       SelectedItem="{Binding SelectedIdentity}"
                       MinHeight="170"
                       AutomationProperties.Name="Connected Microsoft Entra identities">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{DynamicResource VaultColorLine}" BorderThickness="1" Padding="12" Margin="0,0,0,8">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Border Width="38" Height="38" Background="{DynamicResource VaultColorGood}" CornerRadius="19">
                          <TextBlock Text="ID" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="{StaticResource VaultFontSize16}" />
                          <TextBlock Text="{Binding UsernameHint}" Foreground="{DynamicResource VaultColorMuted}" />
                          <TextBlock Text="{Binding Type, StringFormat='Microsoft Entra · {0}'}"
                                     Foreground="{DynamicResource VaultColorMuted}"
                                     FontSize="{StaticResource VaultFontSize11}" />
                        </StackPanel>
                        <Border Grid.Column="2" Background="{DynamicResource VaultColorGoodSoft}" BorderBrush="{DynamicResource VaultColorGood}" BorderThickness="1" Padding="8,4" VerticalAlignment="Center">
                          <TextBlock Text="{Binding AuthenticationState}" Foreground="{DynamicResource VaultColorGood}" FontWeight="Bold" />
                        </Border>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <WrapPanel>
                <Button Classes="primary" Content="Sync selected" Command="{Binding SynchronizeCommand}" Margin="0,0,8,8" />
                <Button Content="Cancel" Command="{Binding CancelOperationCommand}" IsEnabled="{Binding IsBusy}" Margin="0,0,8,8" />
                <Button Content="Reauthenticate" Command="{Binding ReauthenticateIdentityCommand}" Margin="0,0,8,8" />
                <Button Content="Disable" Command="{Binding DisableIdentityCommand}" IsVisible="{Binding IsSelectedIdentityEnabled}" Margin="0,0,8,8" />
                <Button Classes="primary" Content="Enable identity" Command="{Binding EnableIdentityCommand}" IsVisible="{Binding IsSelectedIdentityDisabled}" Margin="0,0,8,8" />
                <Button Content="Purge identity offline values" Command="{Binding PurgeSelectedIdentityCacheCommand}" Margin="0,0,8,8" />
                <Button Content="Revoke local access" Command="{Binding RevokeIdentityAccessCommand}" Margin="0,0,8,8" />
                <Button Content="Remove identity…"
                        Command="{Binding BeginIdentityRemovalCommand}"
                        Margin="0,0,8,8"
                        AutomationProperties.Name="Begin removing selected connected identity" />
              </WrapPanel>
              <Border Classes="atlas-warning"
                      IsVisible="{Binding IsIdentityRemovalConfirmationVisible}">
                <StackPanel Spacing="7">
                  <TextBlock Text="Remove selected identity?" FontWeight="SemiBold" />
                  <TextBlock Text="This removes the selected local identity profile and its cached tokens. It does not delete the Microsoft Entra account. Type REMOVE to confirm."
                             TextWrapping="Wrap" />
                  <TextBox Text="{Binding IdentityRemovalConfirmation}"
                           PlaceholderText="REMOVE"
                           AutomationProperties.Name="Type REMOVE to confirm connected identity removal" />
                  <WrapPanel>
                    <Button Content="Remove selected identity"
                            Command="{Binding RemoveIdentityCommand}"
                            HorizontalAlignment="Left"
                            Margin="0,0,8,0" />
                    <Button Content="Cancel"
                            Command="{Binding CancelIdentityRemovalCommand}"
                            HorizontalAlignment="Left" />
                  </WrapPanel>
                </StackPanel>
              </Border>
              <Expander Classes="atlas-expander"
                        Header="Connection details, errors, and discovery scope"
                        IsExpanded="False">
              <StackPanel Spacing="10" Margin="8">
              <Border IsVisible="{Binding HasSyncErrors}"
                      Classes="atlas-warning"
                      AutomationProperties.Name="Actionable isolated synchronization errors"
                      AutomationProperties.LiveSetting="Polite">
                <StackPanel Spacing="8">
                  <TextBlock Text="{Binding SyncErrors.Count, StringFormat={}{0} synchronized scopes need attention}"
                             FontWeight="SemiBold" />
                  <TextBlock Text="Usable results were preserved. Correct only the affected scope, then retry synchronization."
                             TextWrapping="Wrap" />
                  <ListBox ItemsSource="{Binding SyncErrors}"
                           SelectedItem="{Binding SelectedSyncError}"
                           MaxHeight="220"
                           AutomationProperties.Name="Synchronization error details">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:SyncErrorRow">
                        <StackPanel Margin="4,6" Spacing="2">
                          <TextBlock Text="{Binding Scope}" FontWeight="SemiBold" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Category}" Opacity="0.75" />
                          <TextBlock Text="{Binding Timestamp, StringFormat={}Observed {0}}" Opacity="0.75" />
                          <TextBlock Text="{Binding CorrelationId, StringFormat={}Correlation {0}}" Opacity="0.75" />
                          <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Recovery}" TextWrapping="Wrap" FontWeight="SemiBold" />
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <Button Content="Retry selected scope"
                          Command="{Binding RetrySelectedSyncErrorCommand}"
                          HorizontalAlignment="Left"
                          AutomationProperties.Name="Retry selected failed synchronization scope" />
                </StackPanel>
              </Border>
              <Border IsVisible="{Binding SelectedIdentitySupportsCredentialRotation}"
                      BorderBrush="#344B43"
                      BorderThickness="1"
                      CornerRadius="6"
                      Padding="10">
                <StackPanel Spacing="7">
                  <TextBlock Text="Rotate workload credential" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding CredentialRotationLabel}" />
                  <TextBox Text="{Binding ReplacementCredentialData}"
                           AutomationProperties.Name="Replacement workload credential" />
                  <TextBlock Text="The replacement is validated with Azure before the encrypted profile is changed. The previous profile remains active if validation fails." TextWrapping="Wrap" Opacity="0.75" />
                  <Button Content="Validate and rotate"
                          Command="{Binding RotateSelectedCredentialCommand}"
                          HorizontalAlignment="Left" />
                </StackPanel>
              </Border>
              <TextBlock Text="Revoking local access disables this profile, removes app-owned human tokens or stored workload credential references, and purges offline copies for its discovered vaults. Revoke a compromised certificate or federation trust at its external issuer too." TextWrapping="Wrap" Opacity="0.75" />
              <TextBlock Text="Tenant access paths" FontSize="{StaticResource VaultFontSize17}" FontWeight="SemiBold" Margin="0,8,0,0" />
              <ListBox ItemsSource="{Binding Tenants}"
                       SelectedItem="{Binding SelectedTenant}"
                       MinHeight="90"
                       AutomationProperties.Name="Discovered tenant access paths">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="6">
                      <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding TenantId}" Opacity="0.7" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock Text="Subscription scope" FontSize="{StaticResource VaultFontSize17}" FontWeight="SemiBold" Margin="0,8,0,0" />
              <TextBlock Text="Choose which discovered subscriptions future synchronization may scan. Excluding a subscription does not delete its existing local metadata until a complete synchronization reconciles the scope." TextWrapping="Wrap" Opacity="0.75" />
              <ListBox ItemsSource="{Binding Subscriptions}"
                       SelectedItem="{Binding SelectedSubscription}"
                       MinHeight="150"
                       AutomationProperties.Name="Discovered subscription inclusion list">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto" Margin="6">
                      <StackPanel>
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SubscriptionId}" Opacity="0.7" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding InclusionState}" VerticalAlignment="Center" FontWeight="SemiBold" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <WrapPanel>
                <Button Content="Include selected subscription"
                        Command="{Binding IncludeSubscriptionCommand}"
                        AutomationProperties.Name="Include selected subscription in synchronization"
                        Margin="0,0,8,8" />
                <Button Content="Exclude selected subscription"
                        Command="{Binding ExcludeSubscriptionCommand}"
                        AutomationProperties.Name="Exclude selected subscription from synchronization"
                        Margin="0,0,8,8" />
                <Button Content="Refresh subscriptions"
                        Command="{Binding RefreshSubscriptionsCommand}"
                        AutomationProperties.Name="Refresh discovered subscriptions"
                        Margin="0,0,8,8" />
              </WrapPanel>
              <TextBlock Text="Vault access paths" FontSize="{StaticResource VaultFontSize17}" FontWeight="SemiBold" Margin="0,8,0,0" />
              <TextBlock Text="Observed permissions are reported separately from visibility. Value-read permission is never probed during metadata sync, and writes remain disabled by application policy." TextWrapping="Wrap" Opacity="0.75" />
              <ListBox ItemsSource="{Binding VaultAccessPaths}"
                       SelectedItem="{Binding SelectedVaultAccess}"
                       AutomationProperties.Name="Vault permission and identity access paths">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="#344B43" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,0,0,6">
                      <StackPanel Spacing="3">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="{Binding Vault}" FontWeight="SemiBold" />
                          <TextBlock Grid.Column="1" Text="{Binding InclusionState}" FontWeight="SemiBold" />
                        </Grid>
                        <TextBlock Text="{Binding Identity, StringFormat='Identity: {0}'}" />
                        <TextBlock Text="{Binding Tenant, StringFormat='Tenant: {0}'}" Opacity="0.75" />
                        <TextBlock Text="{Binding Subscription, StringFormat='Subscription: {0}'}" Opacity="0.75" />
                        <TextBlock Text="{Binding PermissionSummary}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding FailureCategory, StringFormat='Observed failures: {0}'}" TextWrapping="Wrap" Opacity="0.75" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <WrapPanel>
                <Button Content="Include selected vault"
                        Command="{Binding IncludeVaultCommand}"
                        AutomationProperties.Name="Include selected vault in synchronization"
                        Margin="0,0,8,8" />
                <Button Content="Exclude selected vault"
                        Command="{Binding ExcludeVaultCommand}"
                        AutomationProperties.Name="Exclude selected vault from synchronization"
                        Margin="0,0,8,8" />
              </WrapPanel>
              </StackPanel>
              </Expander>
            </StackPanel>
          </Border>
          <Border x:Name="ConnectIdentityCard" Grid.Column="1" Classes="atlas-panel">
            <StackPanel Spacing="10">
              <Border Width="62" Height="62" Background="#D7EFE8" HorizontalAlignment="Left">
                <TextBlock Text="⇩" Foreground="{DynamicResource VaultColorGood}" FontSize="{StaticResource VaultFontSize24}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="Next: discover metadata" Classes="section-title" Margin="0,10,0,0" />
              <TextBlock Text="Synchronization reads subscriptions, vaults, and object metadata. It does not retrieve secret values."
                         Classes="screen-description" />
              <TextBlock Text="✓  Names and tags" Foreground="{DynamicResource VaultColorGood}" />
              <TextBlock Text="✓  Vault and subscription context" Foreground="{DynamicResource VaultColorGood}" />
              <TextBlock Text="✓  Secret values remain protected and are never synchronized" Foreground="{DynamicResource VaultColorGood}" />
              <Button Classes="primary"
                      Content="Synchronize selected identity"
                      Command="{Binding SynchronizeCommand}"
                      HorizontalAlignment="Stretch"
                      Margin="0,8,0,0" />
              <Button Content="Continue to Find secrets"
                      Command="{Binding ContinueToSearchCommand}"
                      HorizontalAlignment="Stretch" />
              <TextBlock Text="Select an identity first. You can connect as many interactive accounts as you need."
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource VaultColorMuted}"
                         FontSize="{StaticResource VaultFontSize12}" />

              <Expander Classes="atlas-expander"
                        Header="Add another account"
                        IsExpanded="{Binding IsFirstRun}"
                        Margin="0,10,0,0">
              <StackPanel Spacing="10" Margin="8">
              <TextBlock Text="Connect Microsoft Entra identity" FontSize="{StaticResource VaultFontSize20}" FontWeight="SemiBold" />
              <TextBlock Text="Identity Type" FontWeight="SemiBold" />
              <ComboBox SelectedItem="{Binding SelectedIdentityType}"
                        ItemsSource="{Binding IdentityTypes}"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Identity type" />
              <TextBlock Text="{Binding ManagedIdentityAvailabilityText}"
                         TextWrapping="Wrap"
                         FontSize="{StaticResource VaultFontSize11}"
                         Opacity="0.7" />

              <StackPanel IsVisible="{Binding IsInteractiveUser}" Spacing="10">
                <TextBlock Text="Vault Prospector uses interactive browser sign-in. It never asks for or stores your password." TextWrapping="Wrap" />
                <TextBlock Text="Sign-in registration" FontWeight="SemiBold" />
                <TextBlock Text="Recommended — Vault Prospector product registration (no client secret)" TextWrapping="Wrap" />
                <CheckBox Content="Use my organization's own public-client registration" IsChecked="{Binding UseCustomClientId}" />
                <StackPanel IsVisible="{Binding UseCustomClientId}" Spacing="5">
                  <TextBlock Text="Custom Application (client) ID" />
                  <TextBox Text="{Binding ClientId}" PlaceholderText="00000000-0000-0000-0000-000000000000" AutomationProperties.Name="Custom Microsoft Entra application client ID" />
                  <TextBlock Text="The custom registration must allow multi-tenant public-client flows, http://localhost, Azure Resource Manager, and Azure Key Vault delegated access." TextWrapping="Wrap" FontSize="{StaticResource VaultFontSize11}" Opacity="0.7" />
                </StackPanel>
              </StackPanel>

              <StackPanel IsVisible="{Binding IsWorkloadIdentity}" Spacing="10">
                <TextBlock Text="Tenant ID" />
                <TextBox Text="{Binding TenantId}" PlaceholderText="00000000-0000-0000-0000-000000000000" AutomationProperties.Name="Tenant ID" />
                <TextBlock Text="Client ID" />
                <TextBox Text="{Binding ClientId}" PlaceholderText="Optional for system-assigned Managed Identity" AutomationProperties.Name="Client ID" />
              </StackPanel>

              <StackPanel IsVisible="{Binding IsServicePrincipal}" Spacing="10">
                <TextBlock Text="Certificate Thumbprint" />
                <TextBox Text="{Binding CredentialData}" PlaceholderText="Thumbprint of certificate in Personal store" AutomationProperties.Name="Certificate Thumbprint" />
                <TextBlock Text="The certificate must have an accessible private key and be currently valid. Client secrets are not accepted or stored." TextWrapping="Wrap" FontSize="{StaticResource VaultFontSize11}" Opacity="0.7" />
              </StackPanel>

              <StackPanel IsVisible="{Binding IsFederatedServicePrincipal}" Spacing="10">
                <TextBlock Text="Federated Token File" />
                <TextBox Text="{Binding CredentialData}" PlaceholderText="Absolute path to the projected OIDC token file" AutomationProperties.Name="Federated token file path" />
                <TextBlock Text="Vault Prospector stores only the encrypted file path. The external workload issuer rotates the token file; client secrets and human token caches are never used." TextWrapping="Wrap" FontSize="{StaticResource VaultFontSize11}" Opacity="0.7" />
              </StackPanel>

              <TextBlock Text="Friendly label" />
              <TextBox Text="{Binding IdentityLabel}" PlaceholderText="Customer, employer, lab…" AutomationProperties.Name="Friendly identity label" />

              <TextBlock IsVisible="{Binding IsInteractiveUser}" Text="Microsoft Entra controls the sign-in, consent, MFA, and Conditional Access experience. Vault Prospector receives no password." TextWrapping="Wrap" FontSize="{StaticResource VaultFontSize11}" Opacity="0.7" />
              <Button Classes="primary"
                      Content="{Binding ConnectIdentityActionText}"
                      Command="{Binding AddIdentityCommand}"
                      AutomationProperties.Name="{Binding ConnectIdentityActionText}"
                      HorizontalAlignment="Left" />
              </StackPanel>
              </Expander>
            </StackPanel>
          </Border>
        </Grid>
        </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="⚙  Administration">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="38,30,38,24" Spacing="18">
          <StackPanel Spacing="6">
            <TextBlock Classes="screen-eyebrow" Text="ADVANCED ADMINISTRATION" />
            <TextBlock Classes="screen-title" Text="Workload identities" />
            <TextBlock Classes="screen-description"
                       Text="Discover and assess non-human Azure identities used by applications and Azure resources. Nothing on this page changes Azure automatically." />
          </StackPanel>
          <Grid x:Name="AdministrationGrid"
                ColumnDefinitions="1*,1*"
                RowDefinitions="*"
                ColumnSpacing="14"
                RowSpacing="14">
            <Border Classes="atlas-panel">
              <StackPanel Spacing="10">
                <TextBlock Text="Discover workload identities" FontSize="{StaticResource VaultFontSize20}" FontWeight="SemiBold" />
                <TextBlock Text="A workload identity is a non-human Azure identity used by an application, automation job, or Azure resource. This page helps an administrator inspect eligible customer-managed identities; it does not change Azure."
                           TextWrapping="Wrap"
                           FontWeight="SemiBold" />
                <TextBlock Text="Select an enabled interactive identity on the Identities tab. Discovery uses only that explicit account; it never inherits Azure CLI, PowerShell, IDE, or terminal context." TextWrapping="Wrap" Opacity="0.75" />
                <Button Content="Authorize Microsoft Graph directory read"
                        Command="{Binding AuthorizeDirectoryReadCommand}"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="Authorize service principal directory discovery" />
                <TextBlock Text="Service-principal listing requests delegated Application.Read.All only after this explicit action. Microsoft Entra may require administrator consent. No Graph write permission is requested." TextWrapping="Wrap" Opacity="0.75" />
                <TextBlock Text="Exact subscription ID" />
                <TextBox Text="{Binding AdministrationSubscriptionId}"
                         PlaceholderText="00000000-0000-0000-0000-000000000000"
                         AutomationProperties.Name="Workload administration subscription ID" />
                <TextBlock Text="Exact Key Vault resource ID for permission assessment and optional provisioning preview" />
                <TextBox Text="{Binding AdministrationVaultResourceId}"
                         PlaceholderText="/subscriptions/.../providers/Microsoft.KeyVault/vaults/..."
                         AutomationProperties.Name="Exact Key Vault permission assessment scope" />
                <WrapPanel>
                  <Button Content="List managed identities"
                          Command="{Binding DiscoverManagedIdentitiesCommand}"
                          Margin="0,0,8,8" />
                  <Button Content="List service principals"
                          Command="{Binding DiscoverServicePrincipalsCommand}"
                          Margin="0,0,8,8" />
                </WrapPanel>
                <TextBlock Text="Customer-manageable candidates are shown by default. Microsoft first-party and infrastructure principals are excluded from this list."
                           TextWrapping="Wrap"
                           Opacity="0.75" />
                <Button Content="Assess selected identity permissions"
                        Command="{Binding AssessWorkloadIdentityPermissionsCommand}"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="Assess selected workload identity permissions at exact Key Vault" />
                <TextBlock Text="Assessment is read-only. It evaluates the selected administrator at exact resources and the workload identity's observable RBAC grants, inheritance, deny assignments, and conditions. Conditional or incomplete evidence never appears as allowed." TextWrapping="Wrap" Opacity="0.75" />
                <TextBlock Text="Visible workload identities" FontSize="{StaticResource VaultFontSize17}" FontWeight="SemiBold" />
                <TextBox Text="{Binding WorkloadIdentitySearchText}"
                         PlaceholderText="Filter by name, type, client ID, or principal ID"
                         AutomationProperties.Name="Filter eligible workload identities" />
                <TextBlock Text="{Binding WorkloadIdentityFilterStatus}"
                           TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite" />
                <ListBox ItemsSource="{Binding WorkloadIdentityCandidates}"
                         SelectedItem="{Binding SelectedWorkloadIdentityCandidate}"
                         MinHeight="360"
                         AutomationProperties.Name="Discovered workload identities and permission assessments">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Border BorderBrush="#344B43" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,0,0,6">
                        <StackPanel Spacing="3">
                          <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding IdentityType}" />
                          <TextBlock Text="{Binding State, StringFormat='State: {0}'}" />
                          <TextBlock Text="{Binding ClientId, StringFormat='Client ID: {0}'}" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding PrincipalId, StringFormat='Principal ID: {0}'}" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Scope, StringFormat='Scope: {0}'}" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding PermissionSummary}" TextWrapping="Wrap" Opacity="0.8" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
            </Border>

            <Border x:Name="AdministrationPreviewCard"
                    Grid.Column="1"
                    Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Text="Preview workload provisioning" FontSize="{StaticResource VaultFontSize20}" FontWeight="SemiBold" />
                <Border Classes="atlas-warning">
                  <TextBlock Text="Preview only. This build cannot create identities, assign roles, attach identities, or change Key Vault. The independent security-review gate is still open." TextWrapping="Wrap" />
                </Border>
                <TextBlock Text="Identity name" />
                <TextBox Text="{Binding AdministrationIdentityName}"
                         AutomationProperties.Name="Proposed workload identity name" />
                <TextBlock Text="Resource group (managed identity only)" />
                <TextBox Text="{Binding AdministrationResourceGroup}"
                         AutomationProperties.Name="Proposed managed identity resource group" />
                <TextBlock Text="The optional exact Key Vault scope is entered in the discovery panel." />
                <TextBlock Text="Optional role definition resource ID" />
                <TextBox Text="{Binding AdministrationRoleDefinitionId}"
                         PlaceholderText="/subscriptions/.../providers/Microsoft.Authorization/roleDefinitions/..."
                         AutomationProperties.Name="Exact Key Vault role definition ID" />
                <TextBlock Text="Vault and role must be supplied together. A preview names every exact scope and never contains a credential or secret." TextWrapping="Wrap" Opacity="0.75" />
                <WrapPanel>
                  <Button Content="Preview managed identity"
                          Command="{Binding PreviewManagedIdentityCommand}"
                          Margin="0,0,8,8" />
                  <Button Content="Preview service principal"
                          Command="{Binding PreviewServicePrincipalCommand}"
                          Margin="0,0,8,8" />
                </WrapPanel>
                <TextBlock Text="Generated non-mutating plan" FontSize="{StaticResource VaultFontSize17}" FontWeight="SemiBold" />
                <TextBox Text="{Binding AdministrationPlanText}"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="300"
                         AutomationProperties.Name="Non-mutating workload provisioning plan" />
              </StackPanel>
            </Border>
          </Grid>
          <Border Classes="atlas-warning"
                  BorderBrush="#DC6B6B"
                  BorderThickness="2"
                  IsVisible="{Binding IsGovernedAzureMutationAvailable}"
                  AutomationProperties.Name="Elevated governed Azure operation">
            <StackPanel Spacing="10">
              <TextBlock Text="ELEVATED — governed Azure operation"
                         FontSize="{StaticResource VaultFontSize22}"
                         FontWeight="Bold" />
              <TextBlock Text="This area is available only when the accepted release gate and exact machine policy both allow it. Each preview authorizes one operation at one exact vault; there is no general write-mode switch."
                         TextWrapping="Wrap" />
              <TextBlock Text="Select the exact identity and vault access path on the Identities page before preparing an operation."
                         TextWrapping="Wrap"
                         Opacity="0.8" />
              <TextBlock Text="Operation" />
              <ComboBox ItemsSource="{Binding GovernedAzureOperations}"
                        SelectedItem="{Binding SelectedGovernedAzureOperation}"
                        AutomationProperties.Name="Governed Azure operation" />
              <TextBlock Text="Exact Key Vault object name" />
              <TextBox Text="{Binding GovernedMutationObjectName}"
                       AutomationProperties.Name="Governed mutation object name" />
              <Button Content="Prepare value-free preview"
                      Command="{Binding PrepareGovernedMutationCommand}"
                      HorizontalAlignment="Left" />
              <TextBox Text="{Binding GovernedMutationPreviewText}"
                       IsReadOnly="True"
                       AcceptsReturn="True"
                       TextWrapping="Wrap"
                       MinHeight="250"
                       AutomationProperties.Name="Governed mutation value-free preview" />
              <StackPanel IsVisible="{Binding GovernedMutationRequiresSensitiveValue}"
                          Spacing="6">
                <TextBlock Text="Secret value (never included in preview, logs, or audit)" />
                <TextBox Text="{Binding GovernedMutationSensitiveValue}"
                         PasswordChar="●"
                         AutomationProperties.Name="Secret value for one governed Azure operation" />
              </StackPanel>
              <TextBlock Text="One-time confirmation phrase" />
              <TextBox Text="{Binding GovernedMutationConfirmation}"
                       AutomationProperties.Name="One-time governed mutation confirmation phrase" />
              <WrapPanel>
                <Button Classes="primary"
                        Content="Verify and execute once"
                        Command="{Binding ExecuteGovernedMutationCommand}"
                        Margin="0,0,8,8" />
                <Button Content="Cancel preview"
                        Command="{Binding CancelGovernedMutationCommand}"
                        Margin="0,0,8,8" />
              </WrapPanel>
              <TextBlock Text="{Binding GovernedMutationStatus}"
                         TextWrapping="Wrap"
                         FontWeight="SemiBold"
                         AutomationProperties.LiveSetting="Assertive" />
            </StackPanel>
          </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="▣  Workspaces">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="38,30,38,24" Spacing="18">
        <StackPanel Spacing="6">
          <TextBlock Classes="screen-eyebrow" Text="LOCAL ORGANIZATION" />
          <TextBlock Classes="screen-title" Text="Workspaces" />
          <TextBlock Classes="screen-description"
                     Text="Group customer, project, or environment sources without copying or changing anything in Azure." />
        </StackPanel>
        <Grid x:Name="WorkspaceGrid" ColumnDefinitions="1*,1*" RowDefinitions="*" ColumnSpacing="14" RowSpacing="14">
          <Border Classes="atlas-panel">
            <StackPanel Spacing="10"><TextBlock Text="Your workspaces" Classes="section-title" />
              <TextBlock Text="A workspace is a local view that groups customer, project, or environment sources. It does not create, copy, move, or change anything in Azure."
                         TextWrapping="Wrap"
                         FontWeight="SemiBold" />
              <ListBox ItemsSource="{Binding Workspaces}" SelectedItem="{Binding SelectedWorkspace}" MinHeight="300" AutomationProperties.Name="Vault Prospector workspaces"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" Margin="6" /></DataTemplate></ListBox.ItemTemplate></ListBox>
              <WrapPanel>
                <Button Content="Add selected vault" Command="{Binding AddSelectedVaultToWorkspaceCommand}" Margin="0,0,8,8" />
                <Button Content="Add selected identity" Command="{Binding AddSelectedIdentityToWorkspaceCommand}" Margin="0,0,8,8" />
                <Button Content="Add selected tenant" Command="{Binding AddSelectedTenantToWorkspaceCommand}" Margin="0,0,8,8" />
                <Button Content="Add selected subscription" Command="{Binding AddSelectedSubscriptionToWorkspaceCommand}" Margin="0,0,8,8" />
                <Button Content="Delete workspace" Command="{Binding RemoveWorkspaceCommand}" Margin="0,0,8,8" />
              </WrapPanel>
            </StackPanel>
          </Border>
          <Border x:Name="CreateWorkspaceCard" Grid.Column="1" Classes="atlas-panel">
            <StackPanel Spacing="10"><TextBlock Text="Create workspace" Classes="section-title" />
              <TextBlock Text="Group identities, tenants, subscriptions, and vaults without duplicating indexed data." TextWrapping="Wrap" />
              <TextBox Text="{Binding WorkspaceName}" PlaceholderText="Workspace name" AutomationProperties.Name="New workspace name" />
              <Button Classes="primary" Content="Create" Command="{Binding CreateWorkspaceCommand}" HorizontalAlignment="Left" />
              <TextBlock Text="Selected workspace cache policy" FontSize="{StaticResource VaultFontSize17}" FontWeight="SemiBold" Margin="0,14,0,0" />
              <CheckBox Content="Allow encrypted offline cache for this workspace"
                        IsChecked="{Binding WorkspaceCacheEnabled}"
                        IsEnabled="{Binding IsEnterpriseOfflineCacheAllowed}"
                        AutomationProperties.Name="Allow encrypted offline cache for selected workspace" />
              <TextBlock Text="Maximum cache lifetime (hours)" />
              <NumericUpDown Value="{Binding WorkspaceMaximumCacheHours}"
                             Minimum="1"
                             Maximum="168"
                             IsEnabled="{Binding IsEnterpriseOfflineCacheAllowed}"
                             AutomationProperties.Name="Selected workspace maximum cache lifetime in hours" />
              <CheckBox Content="Allow clipboard copy for this workspace"
                        IsChecked="{Binding WorkspaceAllowClipboard}"
                        IsEnabled="{Binding IsEnterpriseClipboardAllowed}"
                        AutomationProperties.Name="Allow clipboard copy for selected workspace" />
              <CheckBox Content="Require Windows verification (mandatory)"
                        IsChecked="True"
                        IsEnabled="False"
                        AutomationProperties.Name="Windows verification is mandatory for selected workspace" />
              <Button Content="Save selected workspace policy"
                      Command="{Binding SaveWorkspacePolicyCommand}"
                      AutomationProperties.Name="Save selected workspace cache policy"
                      HorizontalAlignment="Left" />
            </StackPanel>
          </Border>
        </Grid>
        </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="◎  Browser fill">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="38,30,38,24" Spacing="14">
            <StackPanel Spacing="6">
              <TextBlock Classes="screen-eyebrow" Text="GUIDED ONE-TIME FILL" />
              <TextBlock Classes="screen-title" Text="Fill the field you selected" />
              <TextBlock Classes="screen-description"
                         Text="The browser supplies the destination context. Choose a source, verify once, and fill only that exact field." />
            </StackPanel>
            <Border x:Name="BrowserSetupStatusCard"
                    Classes="atlas-panel">
              <StackPanel Spacing="8">
                <TextBlock Text="Setup check"
                           FontSize="{StaticResource VaultFontSize20}"
                           FontWeight="SemiBold" />
                <TextBlock Text="1. Browser extension"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding BrowserExtensionStatus}"
                           TextWrapping="Wrap" />
                <Border Classes="atlas-info">
                  <StackPanel Spacing="8">
                    <TextBlock Text="Install the browser extension" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding BrowserInstallationStatus}"
                               TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite" />
                    <WrapPanel>
                      <Button Content="Set up in Edge"
                              Command="{Binding InstallChromiumExtensionCommand}"
                              Margin="0,0,8,8" />
                      <Button Content="Set up in Chrome"
                              Command="{Binding InstallChromeExtensionCommand}"
                              Margin="0,0,8,8" />
                      <Button Content="Set up in Firefox"
                              Command="{Binding InstallFirefoxExtensionCommand}"
                              Margin="0,0,8,8" />
                    </WrapPanel>
                    <TextBlock Text="The reviewed extension is included with Vault Prospector. Browser stores do not allow a desktop application to silently install an extension; these actions open the exact browser page and packaged files you need."
                               TextWrapping="Wrap"
                               Opacity="0.75" />
                  </StackPanel>
                </Border>
                <TextBlock Text="2. Native host"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding BrowserNativeHostStatus}"
                           TextWrapping="Wrap" />
                <TextBlock Text="3. Desktop broker"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding BrowserBrokerStatus}"
                           TextWrapping="Wrap" />
                <TextBlock Text="4. Exact destination policy"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding BrowserDestinationPolicyStatus}"
                           TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite" />
                <TextBlock Text="{Binding BrowserMappingReadinessStatus}"
                           TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite" />
                <Button Content="Refresh setup check"
                        Command="{Binding RefreshBrowserIntegrationCommand}"
                        HorizontalAlignment="Left" />
                <TextBlock Text="Focus a username, current-password, or one-time-code field on an HTTPS page, then choose the Vault Prospector extension. A successful click fills this checklist and opens the guided mapping below."
                           TextWrapping="Wrap"
                           Opacity="0.75" />
              </StackPanel>
            </Border>
            <Border Classes="atlas-panel"
                    AutomationProperties.Name="Browser fill machine policy status">
              <StackPanel Spacing="8">
                <TextBlock Text="Machine policy"
                           FontSize="{StaticResource VaultFontSize20}"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding BrowserPolicyStatus}"
                           TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite" />
                <TextBlock Text="A local mapping alone never authorizes fill. An administrator must also enable this exact destination, browser family, and field purpose in the protected installation policy."
                           TextWrapping="Wrap"
                           Opacity="0.75" />
              </StackPanel>
            </Border>

            <Border Classes="atlas-panel"
                    BorderBrush="#DC6B6B"
                    BorderThickness="2"
                    IsVisible="{Binding IsBrowserFillPending}"
                    AutomationProperties.Name="Browser fill confirmation"
                    AutomationProperties.LiveSetting="Assertive">
              <StackPanel Spacing="10">
                <TextBlock Text="Confirm browser fill"
                           FontSize="{StaticResource VaultFontSize22}"
                           FontWeight="Bold" />
                <TextBlock Text="A browser asked for one mapped value. Confirm both the destination and source; approval still requires fresh Windows verification."
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding BrowserFillDestination, StringFormat='Destination: {0}'}"
                           TextWrapping="Wrap"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding BrowserFillPurpose, StringFormat='Field purpose: {0}'}"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding BrowserFillSource, StringFormat='Source: {0}'}"
                           TextWrapping="Wrap"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding BrowserFillStatus}"
                           TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite" />
                <WrapPanel>
                  <Button Classes="primary"
                          Content="Verify and fill once"
                          Command="{Binding ApproveBrowserFillCommand}"
                          AutomationProperties.Name="Verify with Windows and approve this one browser fill"
                          Margin="0,0,8,8" />
                  <Button Content="Deny"
                          Command="{Binding DenyBrowserFillCommand}"
                          AutomationProperties.Name="Deny this browser fill without retrieving a value"
                          Margin="0,0,8,8" />
                </WrapPanel>
              </StackPanel>
            </Border>

            <Grid x:Name="BrowserMappingGrid"
                  ColumnDefinitions="1*,1*"
                  RowDefinitions="*"
                  ColumnSpacing="14"
                  RowSpacing="14">
              <Border Classes="atlas-panel">
                <StackPanel Spacing="10">
                  <TextBlock Text="Origin-to-secret mappings"
                             FontSize="{StaticResource VaultFontSize20}"
                             FontWeight="SemiBold" />
                  <TextBlock Text="Mappings are encrypted locally and disabled by absence. Wildcards, HTTP pages, browser-internal pages, and private browser password databases are never supported."
                             TextWrapping="Wrap" />
                  <ListBox ItemsSource="{Binding BrowserFillMappings}"
                           SelectedItem="{Binding SelectedBrowserFillMapping}"
                           MinHeight="180"
                           AutomationProperties.Name="Browser fill mappings">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Summary}"
                                   Margin="6"
                                   TextWrapping="Wrap" />
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <WrapPanel>
                    <Button Content="Refresh mappings"
                            Command="{Binding RefreshBrowserIntegrationCommand}"
                            Margin="0,0,8,8" />
                    <Button Content="Remove selected mapping"
                            Command="{Binding RemoveBrowserMappingCommand}"
                            Margin="0,0,8,8" />
                  </WrapPanel>
                </StackPanel>
              </Border>

              <Border x:Name="BrowserGuidedMappingCard"
                      Grid.Column="1"
                      Classes="atlas-panel">
                <StackPanel Spacing="10">
                  <TextBlock Text="Guided destination mapping"
                             FontSize="{StaticResource VaultFontSize20}"
                             FontWeight="SemiBold" />
                  <TextBlock Text="{Binding BrowserCapturedDestination}"
                             TextWrapping="Wrap" />
                  <TextBlock Text="{Binding BrowserDestinationPolicyStatus}"
                             TextWrapping="Wrap"
                             FontWeight="SemiBold" />
                  <TextBlock Text="{Binding BrowserMappingReadinessStatus}"
                             TextWrapping="Wrap" />
                  <TextBlock Text="Eligible secret and identity" />
                  <ComboBox ItemsSource="{Binding BrowserEligibleSources}"
                            SelectedItem="{Binding SelectedBrowserSourceOption}"
                            IsEnabled="{Binding HasCapturedBrowserDestination}"
                            AutomationProperties.Name="Eligible secret and identity for captured browser destination">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Summary}"
                                   TextWrapping="Wrap" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Text="{Binding BrowserSelectedSource}"
                             TextWrapping="Wrap" />
                  <CheckBox Content="Enable this exact mapping"
                            IsChecked="{Binding BrowserMappingEnabled}"
                            IsEnabled="{Binding HasCapturedBrowserDestination}"
                            AutomationProperties.Name="Enable this exact browser mapping" />
                  <Button Classes="primary"
                          Content="Create mapping for captured destination"
                          Command="{Binding SaveBrowserMappingCommand}"
                          AutomationProperties.Name="Create or update the selected source mapping for the browser-captured destination"
                          HorizontalAlignment="Left" />
                  <TextBlock Text="You never type or copy an origin. Saving does not retrieve a value. Return to the same browser field and invoke the extension again for the one-time fill."
                             TextWrapping="Wrap"
                             Opacity="0.75" />
                </StackPanel>
              </Border>
            </Grid>

            <Border Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Text="Recent value-free browser audit"
                           FontSize="{StaticResource VaultFontSize20}"
                           FontWeight="SemiBold" />
                <TextBlock Text="Audit entries contain time, result, canonical origin, field purpose, and local identifiers—never a secret value."
                           TextWrapping="Wrap" />
                <ListBox ItemsSource="{Binding BrowserFillAudit}"
                         MinHeight="140"
                         AutomationProperties.Name="Recent browser fill audit">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Summary}"
                                 Margin="6"
                                 TextWrapping="Wrap" />
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="CyberArk roadmap preview"
               IsVisible="{Binding IsCyberArkPreviewEnabled}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="4,14" Spacing="14">
            <Border Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Text="CyberArk Privilege Cloud"
                           FontSize="{StaticResource VaultFontSize22}"
                           FontWeight="SemiBold" />
                <TextBlock Text="CyberArk is an independent source. Its service-user credential is protected with Windows DPAPI, its metadata is encrypted locally, and it is never merged into an Azure identity or permission model."
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding CyberArkStatus}"
                           TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite" />
              </StackPanel>
            </Border>

            <Grid ColumnDefinitions="0.85*,1.15*" ColumnSpacing="14">
              <Border Classes="card">
                <StackPanel Spacing="10">
                  <TextBlock Text="Profiles"
                             FontSize="{StaticResource VaultFontSize20}"
                             FontWeight="SemiBold" />
                  <ListBox ItemsSource="{Binding CyberArkProfiles}"
                           SelectedItem="{Binding SelectedCyberArkProfile}"
                           MinHeight="150"
                           AutomationProperties.Name="CyberArk profiles">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Margin="6" Spacing="2">
                          <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding PrivilegeCloudUrl}" FontSize="{StaticResource VaultFontSize11}" />
                          <TextBlock Text="{Binding AuthenticationState, StringFormat='State: {0}'}" />
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <WrapPanel>
                    <Button Content="New profile"
                            Command="{Binding NewCyberArkProfileCommand}"
                            Margin="0,0,8,8" />
                    <Button Content="Sync metadata"
                            Command="{Binding SynchronizeCyberArkCommand}"
                            Margin="0,0,8,8" />
                    <Button Content="Enable or disable"
                            Command="{Binding ToggleCyberArkProfileCommand}"
                            Margin="0,0,8,8" />
                  </WrapPanel>
                  <Separator />
                  <TextBlock Text="Revoke or permanently remove"
                             FontWeight="SemiBold" />
                  <TextBlock Text="Type REVOKE CYBERARK to fail closed and delete the local protected credential while retaining metadata, or REMOVE CYBERARK to also remove the profile and synchronized metadata. Value-free audit history is retained. External service-user revocation remains a CyberArk administrator action."
                             TextWrapping="Wrap"
                             Foreground="#FCA5A5" />
                  <TextBox Text="{Binding CyberArkRemoveConfirmation}"
                           PlaceholderText="REVOKE CYBERARK or REMOVE CYBERARK"
                           AutomationProperties.Name="CyberArk profile destructive action confirmation" />
                  <WrapPanel>
                    <Button Content="Revoke local CyberArk access"
                            Command="{Binding RevokeCyberArkProfileCommand}"
                            Background="#B45309"
                            Foreground="White"
                            Margin="0,0,8,8" />
                    <Button Content="Remove selected CyberArk profile"
                            Command="{Binding RemoveCyberArkProfileCommand}"
                            Background="#DC2626"
                            Foreground="White"
                            Margin="0,0,8,8" />
                  </WrapPanel>
                </StackPanel>
              </Border>

              <Border Grid.Column="1" Classes="card">
                <StackPanel Spacing="9">
                  <TextBlock Text="Connect or rotate a service-user credential"
                             FontSize="{StaticResource VaultFontSize20}"
                             FontWeight="SemiBold" />
                  <TextBlock Text="Profile name" />
                  <TextBox Text="{Binding CyberArkProfileName}"
                           AutomationProperties.Name="CyberArk profile name" />
                  <TextBlock Text="CyberArk Identity root URL" />
                  <TextBox Text="{Binding CyberArkIdentityUrl}"
                           PlaceholderText="https://tenant.id.cyberark.cloud/"
                           AutomationProperties.Name="CyberArk Identity root URL" />
                  <TextBlock Text="Privilege Cloud root URL" />
                  <TextBox Text="{Binding CyberArkPrivilegeCloudUrl}"
                           PlaceholderText="https://tenant.privilegecloud.cyberark.cloud/"
                           AutomationProperties.Name="CyberArk Privilege Cloud root URL" />
                  <TextBlock Text="Identity service user" />
                  <TextBox Text="{Binding CyberArkServiceUserName}"
                           PlaceholderText="service-user@example.com"
                           AutomationProperties.Name="CyberArk Identity service user" />
                  <TextBlock Text="Identity application name" />
                  <TextBox Text="{Binding CyberArkApplicationName}"
                           AutomationProperties.Name="CyberArk Identity application name" />
                  <TextBlock Text="Client credential" />
                  <TextBox Text="{Binding CyberArkClientCredential}"
                           PasswordChar="●"
                           AutomationProperties.Name="CyberArk client credential" />
                  <TextBlock Text="The credential is validated before replacement. It is cleared from this form and is never written to SQLCipher metadata or logs."
                             TextWrapping="Wrap"
                             Opacity="0.75" />
                  <Button Classes="primary"
                          Content="Validate and protect credential"
                          Command="{Binding ConnectCyberArkCommand}"
                          HorizontalAlignment="Left" />
                </StackPanel>
              </Border>
            </Grid>

            <Grid ColumnDefinitions="1*,1*" ColumnSpacing="14">
              <Border Classes="card">
                <StackPanel Spacing="10">
                  <TextBlock Text="Encrypted local account index"
                             FontSize="{StaticResource VaultFontSize20}"
                             FontWeight="SemiBold" />
                  <TextBox Text="{Binding CyberArkSearchText}"
                           PlaceholderText="Search account, safe, username, or address"
                           AutomationProperties.Name="Search CyberArk account metadata" />
                  <Button Content="Search local CyberArk metadata"
                          Command="{Binding SearchCyberArkCommand}"
                          HorizontalAlignment="Left" />
                  <ListBox ItemsSource="{Binding CyberArkAccounts}"
                           SelectedItem="{Binding SelectedCyberArkAccount}"
                           MinHeight="220"
                           AutomationProperties.Name="CyberArk accounts">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Summary}"
                                   Margin="6"
                                   TextWrapping="Wrap" />
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </StackPanel>
              </Border>

              <Border Grid.Column="1" Classes="card">
                <StackPanel Spacing="10">
                  <TextBlock Text="Explicit verified retrieval"
                             FontSize="{StaticResource VaultFontSize20}"
                             FontWeight="SemiBold" />
                  <TextBlock Text="{Binding SelectedCyberArkAccount.Summary, FallbackValue='Select an account.'}"
                             TextWrapping="Wrap"
                             FontWeight="SemiBold" />
                  <TextBlock Text="{Binding CyberArkPermissionSummary}"
                             TextWrapping="Wrap" />
                  <TextBlock Text="Secret version" />
                  <ComboBox ItemsSource="{Binding CyberArkVersions}"
                            SelectedItem="{Binding SelectedCyberArkVersion}"
                            AutomationProperties.Name="CyberArk secret version">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Summary}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Text="Non-sensitive business reason (sent to CyberArk audit)" />
                  <TextBox Text="{Binding CyberArkRetrievalReason}"
                           MaxLength="1000"
                           AcceptsReturn="True"
                           MinHeight="64"
                           AutomationProperties.Name="CyberArk retrieval reason" />
                  <TextBlock Text="{Binding CyberArkValuePreview}"
                             FontFamily="Consolas"
                             TextWrapping="Wrap"
                             AutomationProperties.Name="CyberArk protected value preview"
                             AutomationProperties.LiveSetting="Assertive" />
                  <WrapPanel>
                    <Button Classes="primary"
                            Content="Verify and reveal"
                            Command="{Binding RevealCyberArkCommand}"
                            Margin="0,0,8,8" />
                    <Button Content="Verify and copy"
                            Command="{Binding CopyCyberArkCommand}"
                            Margin="0,0,8,8" />
                  </WrapPanel>
                </StackPanel>
              </Border>
            </Grid>

            <Grid ColumnDefinitions="1*,1*" ColumnSpacing="14">
              <Border Classes="card">
                <StackPanel Spacing="10">
                  <TextBlock Text="Safes"
                             FontSize="{StaticResource VaultFontSize20}"
                             FontWeight="SemiBold" />
                  <ListBox ItemsSource="{Binding CyberArkSafes}"
                           MinHeight="140"
                           AutomationProperties.Name="CyberArk safes">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Summary}"
                                   Margin="6"
                                   TextWrapping="Wrap" />
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Classes="card">
                <StackPanel Spacing="10">
                  <TextBlock Text="Value-free local audit"
                             FontSize="{StaticResource VaultFontSize20}"
                             FontWeight="SemiBold" />
                  <TextBlock Text="CyberArk remains the authoritative server-side audit source. Local entries record verification, operation, profile/account context, version, and result—never credentials, tokens, reasons, or values."
                             TextWrapping="Wrap" />
                  <ListBox ItemsSource="{Binding CyberArkAudit}"
                           MinHeight="140"
                           AutomationProperties.Name="CyberArk local audit events">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Summary}"
                                   Margin="6"
                                   TextWrapping="Wrap" />
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </StackPanel>
              </Border>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="⌁  Activity and support">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="38,30,38,24" Spacing="18">
          <StackPanel Spacing="6">
            <TextBlock Classes="screen-eyebrow" Text="ACTIVITY AND SUPPORT" />
            <TextBlock Classes="screen-title" Text="Understand what happened" />
            <TextBlock Classes="screen-description"
                       Text="Review privacy-safe events, actionable errors, and a support bundle you can inspect before sharing." />
          </StackPanel>
          <Grid x:Name="ActivitySupportGrid"
                ColumnDefinitions="1.15*,0.85*"
                RowDefinitions="*"
                ColumnSpacing="14"
                RowSpacing="14">
            <Border Classes="atlas-panel">
              <StackPanel Spacing="10">
                <TextBlock Text="Privacy-safe diagnostics"
                           FontSize="{StaticResource VaultFontSize20}"
                           FontWeight="SemiBold" />
                <TextBlock Text="Vault Prospector records event types, timestamps, pseudonymous identifiers, counts, and safe status categories. It does not record secret values, access tokens, user names, vault names, or object names."
                           TextWrapping="Wrap" />
                <TextBlock Text="External diagnostic log"
                           FontWeight="SemiBold" />
                <TextBox Text="{Binding DiagnosticLogPath, Mode=OneWay}"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         AutomationProperties.Name="External privacy-safe diagnostic log path" />
                <TextBlock Text="This path remains available when the application cannot open. Support may ask you to collect it using the documented procedure."
                           TextWrapping="Wrap"
                           Opacity="0.75" />
                <Button Content="Refresh diagnostics"
                        Command="{Binding RefreshDiagnosticsCommand}"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="Refresh recent privacy-safe diagnostic events" />
                <TextBox Text="{Binding DiagnosticSearchText}"
                         PlaceholderText="Filter by category, safe scope, status, or recovery action"
                         AutomationProperties.Name="Filter recent privacy-safe diagnostic events" />
                <TextBlock Text="{Binding DiagnosticViewerStatus}"
                           TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite" />
                <ListBox ItemsSource="{Binding DiagnosticEvents}"
                         MinHeight="220"
                         MaxHeight="440"
                         AutomationProperties.Name="Recent privacy-safe diagnostic events">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:DiagnosticEventRow">
                      <Border BorderBrush="{DynamicResource VaultColorLine}"
                              BorderThickness="0,0,0,1"
                              Padding="4,8">
                        <StackPanel Spacing="3">
                          <TextBlock Text="{Binding Category}"
                                     FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Timestamp}"
                                     FontSize="{StaticResource VaultFontSize11}" />
                          <TextBlock Text="{Binding Scope}"
                                     TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Summary}"
                                     TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Recovery}"
                                     TextWrapping="Wrap"
                                     Opacity="0.75" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
            </Border>
            <Border x:Name="SupportBundleCard"
                    Grid.Column="1"
                    Classes="atlas-panel">
              <StackPanel Spacing="10">
                <TextBlock Text="Create a support bundle"
                           FontSize="{StaticResource VaultFontSize20}"
                           FontWeight="SemiBold" />
                <TextBlock Text="The bundle contains a manifest and at most the latest 4 MiB of the already-redacted diagnostic log. It excludes settings, databases, tokens, cached values, identities, vault names, and object names."
                           TextWrapping="Wrap" />
                <Button Classes="primary"
                        Content="Create support bundle"
                        Command="{Binding CreateSupportBundleCommand}"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="Create a privacy-safe local support bundle" />
                <TextBlock Text="{Binding SupportBundleStatus}"
                           TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite" />
                <TextBox Text="{Binding LatestSupportBundlePath, Mode=OneWay}"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         AutomationProperties.Name="Latest local support bundle path" />
                <TextBlock Text="Nothing is uploaded automatically. Inspect the ZIP before sharing it."
                           TextWrapping="Wrap"
                           FontWeight="SemiBold" />
              </StackPanel>
            </Border>
          </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="⚙  Settings and updates">
        <ScrollViewer>
        <StackPanel Margin="38,30,38,24" Spacing="18">
          <StackPanel Spacing="6">
            <TextBlock Classes="screen-eyebrow" Text="PREFERENCES AND LIFECYCLE" />
            <TextBlock Classes="screen-title" Text="Settings" />
            <TextBlock Classes="screen-description"
                       Text="Your effective settings combine personal choices, workspace safeguards, and enterprise policy." />
          </StackPanel>
        <Border Classes="atlas-panel" MaxWidth="820" HorizontalAlignment="Left">
          <StackPanel Spacing="12">
            <TextBlock Text="Product updates"
                       FontSize="{StaticResource VaultFontSize22}"
                       FontWeight="SemiBold" />
            <TextBlock Text="Updates are user controlled. Vault Prospector reads trusted release metadata, then downloads and verifies the exact Windows installer before Windows Installer can be started."
                       TextWrapping="Wrap"
                       Opacity="0.8" />
            <Grid ColumnDefinitions="Auto,*"
                  RowDefinitions="Auto,Auto"
                  ColumnSpacing="14"
                  RowSpacing="6">
              <TextBlock Grid.Row="0"
                         Grid.Column="0"
                         Text="Installed"
                         FontWeight="SemiBold" />
              <TextBlock Grid.Row="0"
                         Grid.Column="1"
                         Text="{Binding UpdateCurrentVersion}"
                         AutomationProperties.Name="Installed Vault Prospector version" />
              <TextBlock Grid.Row="1"
                         Grid.Column="0"
                         Text="Latest"
                         FontWeight="SemiBold" />
              <TextBlock Grid.Row="1"
                         Grid.Column="1"
                         Text="{Binding UpdateLatestVersion}"
                         AutomationProperties.Name="Latest trusted Vault Prospector version" />
            </Grid>
            <TextBlock Text="{Binding UpdateStatus}"
                       TextWrapping="Wrap"
                       AutomationProperties.Name="Product update status"
                       AutomationProperties.LiveSetting="Polite" />
            <Border Background="{DynamicResource VaultColorSurfaceAlt}"
                    BorderBrush="{DynamicResource VaultColorLine}"
                    BorderThickness="1"
                    Padding="12">
              <StackPanel Spacing="6">
                <TextBlock Text="Release notes"
                           FontWeight="SemiBold" />
                <ScrollViewer MaxHeight="180"
                              VerticalScrollBarVisibility="Auto">
                  <TextBlock Text="{Binding UpdateReleaseNotes}"
                             TextWrapping="Wrap"
                             AutomationProperties.Name="Trusted release notes" />
                </ScrollViewer>
              </StackPanel>
            </Border>
            <TextBlock Text="{Binding UpdateVerificationStatus}"
                       TextWrapping="Wrap"
                       AutomationProperties.Name="Update package verification status"
                       AutomationProperties.LiveSetting="Polite" />
            <WrapPanel>
              <Button Content="Check for updates"
                      Command="{Binding CheckForUpdatesCommand}"
                      Margin="0,0,8,8"
                      AutomationProperties.Name="Check for trusted Vault Prospector updates" />
              <Button Content="Download and verify"
                      Command="{Binding DownloadUpdateCommand}"
                      Margin="0,0,8,8"
                      AutomationProperties.Name="Download and verify the selected Vault Prospector update" />
              <Button Classes="primary"
                      Content="Launch verified installer"
                      Command="{Binding LaunchVerifiedUpdateCommand}"
                      Margin="0,0,8,8"
                      AutomationProperties.Name="Launch the verified Vault Prospector Windows installer" />
            </WrapPanel>
            <TextBlock Text="The same Windows account retains encrypted local settings and metadata during an in-place upgrade or reinstall. Moving data to another account or device is unsupported. Windows may request administrator approval; the application locks and exits only after a verified installer starts."
                       TextWrapping="Wrap"
                       FontSize="{StaticResource VaultFontSize11}"
                       Opacity="0.72" />
            <Separator Margin="0,8" />
            <TextBlock Text="Security settings" FontSize="{StaticResource VaultFontSize22}" FontWeight="SemiBold" />
            <Border Classes="atlas-info"
                    AutomationProperties.Name="Machine-managed enterprise policy status">
              <StackPanel Spacing="6">
                <TextBlock Text="Machine-managed enterprise policy"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding EnterprisePolicyStatus}"
                           TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite" />
                <TextBlock Text="Administrators configure this read-only policy under HKLM. Invalid or unreadable policy fails closed for governed providers, identities, clipboard, and offline values."
                           TextWrapping="Wrap"
                           Opacity="0.75" />
              </StackPanel>
            </Border>
            <TextBlock Text="Consecutive Reveal verification"
                       FontWeight="SemiBold" />
            <ComboBox ItemsSource="{Binding RevealVerificationGraceOptions}"
                      SelectedItem="{Binding SelectedRevealVerificationGrace}"
                      AutomationProperties.Name="Consecutive reveal verification grace period" />
            <TextBlock Text="{Binding RevealVerificationGraceStatus}"
                       TextWrapping="Wrap"
                       Opacity="0.75"
                       AutomationProperties.LiveSetting="Polite" />
            <CheckBox Content="Enable encrypted offline value cache"
                      IsChecked="{Binding OfflineCacheEnabled}"
                      IsEnabled="{Binding IsEnterpriseOfflineCacheAllowed}" />
            <TextBlock Text="Offline values are disabled by default, encrypted separately, and always require independent Windows verification. Reveal grace never applies to cache, copy, recovery, browser fill, or administration." TextWrapping="Wrap" Opacity="0.75" />
            <TextBlock Text="Maximum cache lifetime (hours)" /><NumericUpDown Value="{Binding MaximumCacheHours}" Minimum="1" Maximum="168" Increment="1" IsEnabled="{Binding IsEnterpriseOfflineCacheAllowed}" AutomationProperties.Name="Maximum offline cache lifetime in hours" />
            <TextBlock Text="Clipboard clear delay (seconds)" /><NumericUpDown Value="{Binding ClipboardClearSeconds}" Minimum="5" Maximum="300" Increment="5" IsEnabled="{Binding IsEnterpriseClipboardAllowed}" AutomationProperties.Name="Clipboard clear delay in seconds" />
            <TextBlock Text="When the main window closes" FontWeight="SemiBold" />
            <ComboBox ItemsSource="{Binding CloseBehaviors}"
                      SelectedItem="{Binding SelectedCloseBehavior}"
                      AutomationProperties.Name="Main window close behavior" />
            <CheckBox Content="Allow metadata-only background synchronization every 15 minutes"
                      IsChecked="{Binding BackgroundMetadataSyncEnabled}"
                      AutomationProperties.Name="Allow metadata-only synchronization while locked in notification area" />
            <CheckBox Content="Hide in the notification area when minimized"
                      IsChecked="{Binding MinimizeToNotificationArea}"
                      AutomationProperties.Name="Hide Vault Prospector in the notification area when minimized" />
            <TextBlock Text="Minimizing immediately hides sensitive presentation, cancels unsafe foreground work, removes the taskbar entry, and requires secure unlock after restoration."
                       TextWrapping="Wrap"
                       Opacity="0.75" />
            <TextBlock Text="Background synchronization is opt-in, never retrieves values, runs only while the window is hidden, network is available, and Windows confirms external power, and stops or reports interaction-required when Azure cannot authenticate silently." TextWrapping="Wrap" Opacity="0.75" />
            <WrapPanel><Button Classes="primary" Content="Save settings" Command="{Binding SaveSettingsCommand}" Margin="0,0,8,8" /><Button Content="Purge selected vault" Command="{Binding PurgeSelectedVaultCacheCommand}" Margin="0,0,8,8" /><Button Content="Purge selected workspace" Command="{Binding PurgeSelectedWorkspaceCacheCommand}" Margin="0,0,8,8" /><Button Content="Purge all offline values" Command="{Binding PurgeAllCachedValuesCommand}" Margin="0,0,8,8" /></WrapPanel>
            <Separator Margin="0,8" />
            <TextBlock Text="Recovery archive retention" FontSize="{StaticResource VaultFontSize18}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding RecoveryArchiveStatus}" TextWrapping="Wrap" Opacity="0.8" AutomationProperties.LiveSetting="Polite" />
            <ListBox ItemsSource="{Binding RecoveryArchives}"
                     SelectedItem="{Binding SelectedRecoveryArchive}"
                     MinHeight="72"
                     MaxHeight="180"
                     AutomationProperties.Name="Retained local recovery archives">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:LocalRecoveryArchiveRow">
                  <StackPanel Margin="4,6" Spacing="2">
                    <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Id}" FontFamily="Consolas" FontSize="{StaticResource VaultFontSize11}" TextWrapping="Wrap" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Button Content="Refresh recovery archives"
                    Command="{Binding RefreshRecoveryArchivesCommand}"
                    HorizontalAlignment="Left"
                    AutomationProperties.Name="Refresh retained local recovery archives" />
            <StackPanel Spacing="8">
              <TextBlock Text="Deleting an archive is permanent. It can remove the only matched-key recovery copy or support evidence. Select one, type DELETE ARCHIVE exactly, and complete fresh Windows verification." TextWrapping="Wrap" Foreground="#FCA5A5" />
              <TextBox Text="{Binding RecoveryArchiveDeleteConfirmation}"
                       PlaceholderText="DELETE ARCHIVE"
                       AutomationProperties.Name="Recovery archive deletion confirmation" />
              <Button Content="Verify and permanently delete selected archive"
                      Command="{Binding DeleteSelectedRecoveryArchiveCommand}"
                      Background="#DC2626"
                      Foreground="White"
                      HorizontalAlignment="Left"
                      AutomationProperties.Name="Verify and permanently delete selected recovery archive" />
            </StackPanel>
            <TextBlock Text="Telemetry is disabled. Logs contain no tokens, values, usernames, vault names, or object names." TextWrapping="Wrap" FontSize="{StaticResource VaultFontSize11}" Opacity="0.7" />
          </StackPanel>
        </Border>
        </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="ⓘ  About">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="38,30,38,24" Spacing="18">
        <StackPanel Spacing="6">
          <TextBlock Classes="screen-eyebrow" Text="PRODUCT INFORMATION" />
          <TextBlock Classes="screen-title" Text="Vault Prospector" />
          <TextBlock Classes="screen-description" Text="Secure Azure retrieval with clear tenant, workspace, and source boundaries." />
        </StackPanel>
        <Border Classes="atlas-panel" MaxWidth="820" HorizontalAlignment="Left" VerticalAlignment="Top">
          <StackPanel Spacing="10"><TextBlock Text="{Binding VersionLabel}" FontSize="{StaticResource VaultFontSize24}" FontWeight="SemiBold" />
            <TextBlock Text="A local-first Azure Key Vault discovery, search, and secure retrieval desktop application." TextWrapping="Wrap" />
            <TextBlock Text="This preview never creates role assignments, rotates secrets, or silently caches values. Azure remains the source of truth." TextWrapping="Wrap" />
            <TextBlock Text="Mobile apps are intentionally deferred and tracked on the roadmap." TextWrapping="Wrap" Opacity="0.75" />
          </StackPanel>
        </Border>
        </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <Border Grid.Row="3" Background="{DynamicResource VaultColorSurface}" BorderBrush="{DynamicResource VaultColorLine}" BorderThickness="0,1,0,0" Padding="18,10">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
        <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsBusy}">
          <TextBlock Text="{Binding ActiveOperationText}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
          <ProgressBar IsIndeterminate="True" Width="120" AutomationProperties.Name="Operation in progress" />
        </StackPanel>
        <Button Grid.Column="2" Content="Cancel active operation" Command="{Binding CancelOperationCommand}" IsVisible="{Binding IsBusy}" AutomationProperties.Name="Cancel the active operation" />
      </Grid>
    </Border>
  </Grid>
</Window>
