<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VaultProspector.App.ViewModels"
        x:Class="VaultProspector.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1180" Height="760" MinWidth="320" MinHeight="300"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/vault-prospector.ico"
        Title="Vault Prospector">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Background="{DynamicResource VaultColorCanvas}">
    <Border Grid.Row="0" Background="#143E35">
      <Grid RowDefinitions="Auto,Auto">
        <Grid ColumnDefinitions="*,Auto" Margin="22,12">
          <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <Border Width="38" Height="38" Background="#DCEEE8" CornerRadius="4">
              <TextBlock Text="VP" Foreground="#084E42" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel>
              <TextBlock Text="Vault Prospector" Foreground="White" FontSize="{StaticResource VaultFontSize18}" FontWeight="SemiBold" />
              <TextBlock Text="Secure Azure retrieval" Foreground="#BED1CA" FontSize="{StaticResource VaultFontSize11}" />
            </StackPanel>
          </StackPanel>
          <Border x:Name="HeaderContextBadge" Grid.Column="1" Background="#24584D" CornerRadius="4" Padding="12,7" VerticalAlignment="Center">
            <TextBlock Text="LOCAL-FIRST · READ-ONLY BY DEFAULT" Foreground="#D1FAE5" FontSize="{StaticResource VaultFontSize11}" />
          </Border>
        </Grid>
        <Border Grid.Row="1" Background="#EFF3F0" BorderBrush="{DynamicResource VaultColorLine}" BorderThickness="0,1,0,0" Padding="22,8">
          <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="20">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="Workspace" Foreground="{DynamicResource VaultColorMuted}" />
              <TextBlock Text="{Binding SelectedWorkspace.Name, FallbackValue=All discovered sources}" FontWeight="SemiBold" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding Identities.Count, StringFormat={}{0} identities}" />
            <TextBlock Grid.Column="2" Text="{Binding Results.Count, StringFormat={}{0} indexed objects}" />
            <TextBlock Grid.Column="4" Text="Values stay protected until an explicit reveal." Foreground="{DynamicResource VaultColorMuted}" />
          </Grid>
        </Border>
      </Grid>
    </Border>

    <Border Grid.Row="1" IsVisible="{Binding HasActionableError}" Background="#3F1616" BorderBrush="#DC6B6B" BorderThickness="1" CornerRadius="6" Margin="18,12,18,0" Padding="14" AutomationProperties.Name="{Binding ErrorAnnouncement}" AutomationProperties.LiveSetting="Assertive">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
        <TextBlock Text="!" FontSize="{StaticResource VaultFontSize22}" FontWeight="Bold" Foreground="#FCA5A5" />
        <StackPanel Grid.Column="1" Spacing="4">
          <TextBlock Text="{Binding ErrorTitle}" FontSize="{StaticResource VaultFontSize16}" FontWeight="SemiBold" Foreground="White" />
          <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="White" />
          <TextBlock Text="{Binding RecoveryText}" TextWrapping="Wrap" Foreground="#FECACA" FontWeight="SemiBold" />
          <Button x:Name="ActionableErrorAnnouncementTarget" Content="Return to previous action" Click="ActionableErrorAnnouncementTarget_OnClick" AutomationProperties.Name="{Binding ErrorAnnouncement}" Background="#FECACA" Foreground="#3F1616" HorizontalAlignment="Left" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="2" Margin="18" Classes="card" IsVisible="{Binding IsLocalDataBlocked}" MaxWidth="680" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel Spacing="16">
        <TextBlock Text="{Binding LocalDataFailureTitle}" FontSize="{StaticResource VaultFontSize24}" FontWeight="Bold" Foreground="#FCA5A5" />
        <TextBlock Text="{Binding LocalDataRecoveryGuidance}" TextWrapping="Wrap" />
        <StackPanel IsVisible="{Binding CanResetLocalData}" Spacing="10">
          <TextBlock Text="This operation archives the database, Windows-protected keys, offline values, identity cache, settings, and logs together. It does not delete or silently replace the failed state." TextWrapping="Wrap" Opacity="0.8" />
          <TextBlock Text="Type RESET to confirm that you want to archive this local state and start fresh." TextWrapping="Wrap" FontWeight="SemiBold" />
          <TextBox Text="{Binding ResetConfirmation}" PlaceholderText="RESET" AutomationProperties.Name="Local data reset confirmation" />
          <Button Classes="primary"
                  Background="#DC2626"
                  Content="Verify and archive local data"
                  Command="{Binding ArchiveAndResetLocalDataCommand}"
                  AutomationProperties.Name="Verify and archive local Vault Prospector data"
                  HorizontalAlignment="Left" />
        </StackPanel>
        <StackPanel IsVisible="{Binding IsRecoveryComplete}" Spacing="8">
          <TextBlock Text="Encrypted local state was archived. Close and reopen Vault Prospector to create fresh state, then reconnect Azure identities." TextWrapping="Wrap" FontWeight="SemiBold" />
          <TextBlock Text="{Binding RecoveryArchivePath, StringFormat='Recovery archive: {0}'}" TextWrapping="Wrap" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Grid.Row="2" Margin="18" Classes="card" IsVisible="{Binding !IsUnlocked}" MaxWidth="500" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel Spacing="16">
        <TextBlock Text="Application Locked" FontSize="{StaticResource VaultFontSize24}" FontWeight="Bold" />
        <TextBlock Text="{Binding UnlockMessage}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding UnlockRecovery}" TextWrapping="Wrap" Opacity="0.8" />
        <Button Classes="primary" Content="Unlock Vault Prospector" Command="{Binding InitializeCommand}" HorizontalAlignment="Left" />
      </StackPanel>
    </Border>

    <Border Grid.Row="2"
            ZIndex="20"
            IsVisible="{Binding IsCloseChoiceVisible}"
            Background="#E80B1713"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            AutomationProperties.Name="Choose what Vault Prospector does when the window closes">
      <Border Classes="card"
              MaxWidth="560"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Margin="20">
        <StackPanel Spacing="14">
          <TextBlock Text="Close Vault Prospector" FontSize="{StaticResource VaultFontSize24}" FontWeight="Bold" />
          <TextBlock Text="Choose explicitly. Continuing in the notification area immediately hides any revealed value and locks foreground access. Exiting clears an unchanged app-owned clipboard value and stops background work." TextWrapping="Wrap" />
          <Button Classes="primary"
                  Content="Lock and continue in notification area"
                  Command="{Binding ContinueInBackgroundCommand}"
                  AutomationProperties.Name="Lock Vault Prospector and continue metadata-only work in notification area" />
          <Button Content="Exit Vault Prospector"
                  Command="{Binding RequestExitCommand}"
                  AutomationProperties.Name="Exit Vault Prospector and clear temporary sensitive state" />
          <Button Content="Cancel"
                  Command="{Binding CancelCloseCommand}"
                  AutomationProperties.Name="Cancel closing Vault Prospector" />
        </StackPanel>
      </Border>
    </Border>

    <TabControl x:Name="MainTabs"
                Grid.Row="2"
                Classes="product-shell"
                TabStripPlacement="Left"
                Margin="18,14"
                IsVisible="{Binding IsApplicationReady}"
                SelectedIndex="{Binding SelectedMainTabIndex}">
      <TabItem Header="Find secrets">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid RowDefinitions="Auto,*,Auto" Margin="4,14,4,4">
          <Border Classes="card">
            <StackPanel Spacing="10">
              <Grid x:Name="SearchCommandGrid" ColumnDefinitions="*,150,Auto" ColumnSpacing="10" RowSpacing="8">
                <TextBox x:Name="SearchTextBox" PlaceholderText="Search names, tags, and metadata" Text="{Binding SearchText}" KeyUp="SearchBox_OnKeyUp" AutomationProperties.Name="Search vault metadata" />
                <ComboBox x:Name="ObjectTypeComboBox" Grid.Column="1" ItemsSource="{Binding ObjectTypes}" SelectedItem="{Binding SelectedObjectType}" AutomationProperties.Name="Object type filter" />
                <Button x:Name="SearchButton" Grid.Column="2" Classes="primary" Content="Search" Command="{Binding SearchCommand}" AutomationProperties.Name="Search vault metadata" />
              </Grid>
              <WrapPanel Orientation="Horizontal">
                <CheckBox Content="Favorites" IsChecked="{Binding FavoritesOnly}" Margin="0,0,14,6" />
                <CheckBox Content="Stale" IsChecked="{Binding StaleOnly}" Margin="0,0,14,6" />
                <CheckBox Content="Enabled" IsChecked="{Binding EnabledOnly}" Margin="0,0,14,6" />
                <CheckBox Content="Expired" IsChecked="{Binding ExpiredOnly}" Margin="0,0,14,6" />
                <CheckBox Content="Selected identity" IsChecked="{Binding FilterSelectedIdentity}" IsEnabled="{Binding HasSelectedIdentity}" Margin="0,0,14,6" />
                <CheckBox Content="Selected workspace" IsChecked="{Binding FilterSelectedWorkspace}" IsEnabled="{Binding HasSelectedWorkspace}" Margin="0,0,14,6" />
                <CheckBox Content="Recent first" IsChecked="{Binding RecentlyAccessedFirst}" Margin="0,0,14,6" />
              </WrapPanel>
              <Grid x:Name="SearchFilterGrid" ColumnDefinitions="*,*,*" ColumnSpacing="10" RowSpacing="8">
                <ComboBox x:Name="TenantFilterComboBox"
                          ItemsSource="{Binding TenantFilterOptions}"
                          SelectedItem="{Binding SelectedTenantFilterOption}"
                          AutomationProperties.Name="Tenant filter">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SearchFilterOption"><TextBlock Text="{Binding Label}" /></DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox x:Name="SubscriptionFilterComboBox"
                          Grid.Column="1"
                          ItemsSource="{Binding SubscriptionFilterOptions}"
                          SelectedItem="{Binding SelectedSubscriptionFilterOption}"
                          AutomationProperties.Name="Subscription filter">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SearchFilterOption"><TextBlock Text="{Binding Label}" /></DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox x:Name="VaultFilterComboBox"
                          Grid.Column="2"
                          ItemsSource="{Binding VaultFilterOptions}"
                          SelectedItem="{Binding SelectedVaultFilterOption}"
                          AutomationProperties.Name="Vault filter">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SearchFilterOption"><TextBlock Text="{Binding Label}" /></DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </Grid>
            </StackPanel>
          </Border>
          <Grid x:Name="SearchResultsGrid" Grid.Row="1" ColumnDefinitions="2*,1*" RowDefinitions="*" MinHeight="260" Margin="0,14,0,14" ColumnSpacing="14" RowSpacing="14">
            <Border Classes="card">
              <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
              <Grid RowDefinitions="Auto,*" MinWidth="600">
                <Grid ColumnDefinitions="36,2*,120,160,120" Margin="8,0,8,8">
                  <TextBlock Text="" /><TextBlock Grid.Column="1" Text="NAME" FontWeight="Bold" FontSize="{StaticResource VaultFontSize11}" />
                  <TextBlock Grid.Column="2" Text="TYPE" FontWeight="Bold" FontSize="{StaticResource VaultFontSize11}" />
                  <TextBlock Grid.Column="3" Text="VAULT" FontWeight="Bold" FontSize="{StaticResource VaultFontSize11}" />
                  <TextBlock Grid.Column="4" Text="STATE" FontWeight="Bold" FontSize="{StaticResource VaultFontSize11}" />
                </Grid>
                <ListBox Grid.Row="1" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}" AutomationProperties.Name="Vault search results">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SearchResultRow">
                      <Grid ColumnDefinitions="36,2*,120,160,120" Margin="6,8">
                        <TextBlock Text="{Binding FavoriteMarker}" Foreground="#E3A008" />
                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Text="{Binding Type}" />
                        <TextBlock Grid.Column="3" Text="{Binding Vault}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="4" Text="{Binding State}" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
              </ScrollViewer>
            </Border>
            <Border x:Name="SelectedObjectCard" Grid.Column="1" Classes="card">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="10">
                <TextBlock Text="Selected object" FontSize="{StaticResource VaultFontSize18}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding SelectedResult.Name, FallbackValue=Nothing selected}" FontSize="{StaticResource VaultFontSize16}" AutomationProperties.Name="Selected object name" />
                <TextBlock Text="{Binding SelectedResult.Vault}" Opacity="0.75" AutomationProperties.Name="Selected object vault" />
                <TextBlock Text="{Binding SelectedResult.Identity}" Opacity="0.75" AutomationProperties.Name="Selected object identity" />
                <TextBlock Text="{Binding SelectedResult.Tenant}" Opacity="0.75" TextWrapping="Wrap" AutomationProperties.Name="Selected object tenant" />
                <TextBlock Text="{Binding SelectedResult.AccessStatus}" Opacity="0.75" TextWrapping="Wrap" AutomationProperties.Name="Selected object effective permission assessment" />
                <Border Background="#101D2B23" CornerRadius="6" Padding="12" Margin="0,8">
                  <TextBlock Text="{Binding SecretPreview}" FontFamily="Consolas" TextWrapping="Wrap" AutomationProperties.Name="Masked secret value" />
                </Border>
                <WrapPanel Orientation="Horizontal">
                  <Button Content="Reveal" Command="{Binding RevealCommand}" Margin="0,0,8,8" />
                  <Button Content="Copy securely" Command="{Binding CopyCommand}" Margin="0,0,8,8" />
                  <Button Content="Favorite" Command="{Binding ToggleFavoriteCommand}" Margin="0,0,8,8" />
                  <Button Content="Cache offline" Command="{Binding CacheSelectedCommand}" Margin="0,0,8,8" />
                  <Button Content="Open offline" Command="{Binding OpenOfflineCommand}" Margin="0,0,8,8" />
                  <Button Content="Purge offline copy" Command="{Binding PurgeSelectedCachedValueCommand}" Margin="0,0,8,8" />
                </WrapPanel>
                <TextBlock Text="Values are retrieved only after explicit action and Windows Hello verification." FontSize="{StaticResource VaultFontSize11}" Opacity="0.7" TextWrapping="Wrap" />
              </StackPanel>
              </ScrollViewer>
            </Border>
          </Grid>
          <TextBlock Grid.Row="2" Text="{Binding Results.Count, StringFormat={}{0} indexed objects}" Opacity="0.7" />
        </Grid>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Connections">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid x:Name="IdentityGrid" ColumnDefinitions="1*,1*" RowDefinitions="*" Margin="4,14" ColumnSpacing="14" RowSpacing="14">
          <Border Classes="card">
            <StackPanel Spacing="10">
              <TextBlock Text="Connected identities" FontSize="{StaticResource VaultFontSize20}" FontWeight="SemiBold" />
              <TextBlock Text="Each identity keeps an explicit tenant and vault access path." TextWrapping="Wrap" Opacity="0.75" />
              <ListBox ItemsSource="{Binding Identities}" SelectedItem="{Binding SelectedIdentity}" MinHeight="300" AutomationProperties.Name="Connected Microsoft Entra identities">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="6">
                      <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding UsernameHint}" Opacity="0.7" />
                      <TextBlock Text="{Binding Type, StringFormat='Type: {0}'}" Opacity="0.75" />
                      <TextBlock Text="{Binding AuthenticationState, StringFormat='State: {0}'}" Opacity="0.75" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <WrapPanel>
                <Button Classes="primary" Content="Sync selected" Command="{Binding SynchronizeCommand}" Margin="0,0,8,8" />
                <Button Content="Cancel" Command="{Binding CancelOperationCommand}" IsEnabled="{Binding IsBusy}" Margin="0,0,8,8" />
                <Button Content="Reauthenticate" Command="{Binding ReauthenticateIdentityCommand}" Margin="0,0,8,8" />
                <Button Content="Disable" Command="{Binding DisableIdentityCommand}" Margin="0,0,8,8" />
                <Button Content="Enable" Command="{Binding EnableIdentityCommand}" Margin="0,0,8,8" />
                <Button Content="Purge identity offline values" Command="{Binding PurgeSelectedIdentityCacheCommand}" Margin="0,0,8,8" />
                <Button Content="Revoke local access" Command="{Binding RevokeIdentityAccessCommand}" Margin="0,0,8,8" />
                <Button Content="Remove identity" Command="{Binding RemoveIdentityCommand}" Margin="0,0,8,8" />
              </WrapPanel>
              <Border IsVisible="{Binding SelectedIdentitySupportsCredentialRotation}"
                      BorderBrush="#344B43"
                      BorderThickness="1"
                      CornerRadius="6"
                      Padding="10">
                <StackPanel Spacing="7">
                  <TextBlock Text="Rotate workload credential" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding CredentialRotationLabel}" />
                  <TextBox Text="{Binding ReplacementCredentialData}"
                           AutomationProperties.Name="Replacement workload credential" />
                  <TextBlock Text="The replacement is validated with Azure before the encrypted profile is changed. The previous profile remains active if validation fails." TextWrapping="Wrap" Opacity="0.75" />
                  <Button Content="Validate and rotate"
                          Command="{Binding RotateSelectedCredentialCommand}"
                          HorizontalAlignment="Left" />
                </StackPanel>
              </Border>
              <TextBlock Text="Revoking local access disables this profile, removes app-owned human tokens or stored workload credential references, and purges offline copies for its discovered vaults. Revoke a compromised certificate or federation trust at its external issuer too." TextWrapping="Wrap" Opacity="0.75" />
              <TextBlock Text="Tenant access paths" FontSize="{StaticResource VaultFontSize17}" FontWeight="SemiBold" Margin="0,8,0,0" />
              <ListBox ItemsSource="{Binding Tenants}"
                       SelectedItem="{Binding SelectedTenant}"
                       MinHeight="90"
                       AutomationProperties.Name="Discovered tenant access paths">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="6">
                      <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding TenantId}" Opacity="0.7" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock Text="Subscription scope" FontSize="{StaticResource VaultFontSize17}" FontWeight="SemiBold" Margin="0,8,0,0" />
              <TextBlock Text="Choose which discovered subscriptions future synchronization may scan. Excluding a subscription does not delete its existing local metadata until a complete synchronization reconciles the scope." TextWrapping="Wrap" Opacity="0.75" />
              <ListBox ItemsSource="{Binding Subscriptions}"
                       SelectedItem="{Binding SelectedSubscription}"
                       MinHeight="150"
                       AutomationProperties.Name="Discovered subscription inclusion list">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto" Margin="6">
                      <StackPanel>
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SubscriptionId}" Opacity="0.7" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding InclusionState}" VerticalAlignment="Center" FontWeight="SemiBold" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <WrapPanel>
                <Button Content="Include selected subscription"
                        Command="{Binding IncludeSubscriptionCommand}"
                        AutomationProperties.Name="Include selected subscription in synchronization"
                        Margin="0,0,8,8" />
                <Button Content="Exclude selected subscription"
                        Command="{Binding ExcludeSubscriptionCommand}"
                        AutomationProperties.Name="Exclude selected subscription from synchronization"
                        Margin="0,0,8,8" />
                <Button Content="Refresh subscriptions"
                        Command="{Binding RefreshSubscriptionsCommand}"
                        AutomationProperties.Name="Refresh discovered subscriptions"
                        Margin="0,0,8,8" />
              </WrapPanel>
              <TextBlock Text="Vault access paths" FontSize="{StaticResource VaultFontSize17}" FontWeight="SemiBold" Margin="0,8,0,0" />
              <TextBlock Text="Observed permissions are reported separately from visibility. Value-read permission is never probed during metadata sync, and writes remain disabled by application policy." TextWrapping="Wrap" Opacity="0.75" />
              <ListBox ItemsSource="{Binding VaultAccessPaths}"
                       SelectedItem="{Binding SelectedVaultAccess}"
                       AutomationProperties.Name="Vault permission and identity access paths">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="#344B43" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,0,0,6">
                      <StackPanel Spacing="3">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="{Binding Vault}" FontWeight="SemiBold" />
                          <TextBlock Grid.Column="1" Text="{Binding InclusionState}" FontWeight="SemiBold" />
                        </Grid>
                        <TextBlock Text="{Binding Identity, StringFormat='Identity: {0}'}" />
                        <TextBlock Text="{Binding Tenant, StringFormat='Tenant: {0}'}" Opacity="0.75" />
                        <TextBlock Text="{Binding Subscription, StringFormat='Subscription: {0}'}" Opacity="0.75" />
                        <TextBlock Text="{Binding PermissionSummary}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding FailureCategory, StringFormat='Observed failures: {0}'}" TextWrapping="Wrap" Opacity="0.75" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <WrapPanel>
                <Button Content="Include selected vault"
                        Command="{Binding IncludeVaultCommand}"
                        AutomationProperties.Name="Include selected vault in synchronization"
                        Margin="0,0,8,8" />
                <Button Content="Exclude selected vault"
                        Command="{Binding ExcludeVaultCommand}"
                        AutomationProperties.Name="Exclude selected vault from synchronization"
                        Margin="0,0,8,8" />
              </WrapPanel>
            </StackPanel>
          </Border>
          <Border x:Name="ConnectIdentityCard" Grid.Column="1" Classes="card">
            <StackPanel Spacing="10">
              <Border IsVisible="{Binding IsFirstRun}" Background="#123F36" BorderBrush="#2D8A76" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,6">
                <StackPanel Spacing="5">
                  <TextBlock Text="Set up Vault Prospector" FontSize="{StaticResource VaultFontSize17}" FontWeight="SemiBold" Foreground="White" />
                  <TextBlock Text="1. Local unlock is complete. Windows verified you so Vault Prospector can open its encrypted local data. This is separate from Azure sign-in." TextWrapping="Wrap" Foreground="White" />
                  <TextBlock Text="2. Connect Microsoft Entra. Microsoft handles your password, passkey, MFA, and Conditional Access in the system browser; Vault Prospector never receives them." TextWrapping="Wrap" Foreground="White" />
                  <TextBlock Text="3. Review the discovered scope, then choose Sync. Sync indexes metadata only; values stay in Key Vault until you explicitly request one and verify again." TextWrapping="Wrap" Foreground="White" />
                </StackPanel>
              </Border>
              <TextBlock Text="Connect Microsoft Entra identity" FontSize="{StaticResource VaultFontSize20}" FontWeight="SemiBold" />

              <TextBlock Text="Identity Type" FontWeight="SemiBold" />
              <ComboBox SelectedItem="{Binding SelectedIdentityType}"
                        ItemsSource="{Binding IdentityTypes}"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Identity type" />
              <TextBlock Text="{Binding ManagedIdentityAvailabilityText}"
                         TextWrapping="Wrap"
                         FontSize="{StaticResource VaultFontSize11}"
                         Opacity="0.7" />

              <StackPanel IsVisible="{Binding IsInteractiveUser}" Spacing="10">
                <TextBlock Text="Vault Prospector uses interactive browser sign-in. It never asks for or stores your password." TextWrapping="Wrap" />
                <TextBlock Text="Sign-in registration" FontWeight="SemiBold" />
                <TextBlock Text="Recommended — Vault Prospector product registration (no client secret)" TextWrapping="Wrap" />
                <CheckBox Content="Use my organization's own public-client registration" IsChecked="{Binding UseCustomClientId}" />
                <StackPanel IsVisible="{Binding UseCustomClientId}" Spacing="5">
                  <TextBlock Text="Custom Application (client) ID" />
                  <TextBox Text="{Binding ClientId}" PlaceholderText="00000000-0000-0000-0000-000000000000" AutomationProperties.Name="Custom Microsoft Entra application client ID" />
                  <TextBlock Text="The custom registration must allow multi-tenant public-client flows, http://localhost, Azure Resource Manager, and Azure Key Vault delegated access." TextWrapping="Wrap" FontSize="{StaticResource VaultFontSize11}" Opacity="0.7" />
                </StackPanel>
              </StackPanel>

              <StackPanel IsVisible="{Binding IsWorkloadIdentity}" Spacing="10">
                <TextBlock Text="Tenant ID" />
                <TextBox Text="{Binding TenantId}" PlaceholderText="00000000-0000-0000-0000-000000000000" AutomationProperties.Name="Tenant ID" />
                <TextBlock Text="Client ID" />
                <TextBox Text="{Binding ClientId}" PlaceholderText="Optional for system-assigned Managed Identity" AutomationProperties.Name="Client ID" />
              </StackPanel>

              <StackPanel IsVisible="{Binding IsServicePrincipal}" Spacing="10">
                <TextBlock Text="Certificate Thumbprint" />
                <TextBox Text="{Binding CredentialData}" PlaceholderText="Thumbprint of certificate in Personal store" AutomationProperties.Name="Certificate Thumbprint" />
                <TextBlock Text="The certificate must have an accessible private key and be currently valid. Client secrets are not accepted or stored." TextWrapping="Wrap" FontSize="{StaticResource VaultFontSize11}" Opacity="0.7" />
              </StackPanel>

              <StackPanel IsVisible="{Binding IsFederatedServicePrincipal}" Spacing="10">
                <TextBlock Text="Federated Token File" />
                <TextBox Text="{Binding CredentialData}" PlaceholderText="Absolute path to the projected OIDC token file" AutomationProperties.Name="Federated token file path" />
                <TextBlock Text="Vault Prospector stores only the encrypted file path. The external workload issuer rotates the token file; client secrets and human token caches are never used." TextWrapping="Wrap" FontSize="{StaticResource VaultFontSize11}" Opacity="0.7" />
              </StackPanel>

              <TextBlock Text="Friendly label" />
              <TextBox Text="{Binding IdentityLabel}" PlaceholderText="Customer, employer, lab…" AutomationProperties.Name="Friendly identity label" />

              <TextBlock IsVisible="{Binding IsInteractiveUser}" Text="Microsoft Entra controls the sign-in, consent, MFA, and Conditional Access experience. Vault Prospector receives no password." TextWrapping="Wrap" FontSize="{StaticResource VaultFontSize11}" Opacity="0.7" />
              <Button Classes="primary"
                      Content="{Binding ConnectIdentityActionText}"
                      Command="{Binding AddIdentityCommand}"
                      AutomationProperties.Name="{Binding ConnectIdentityActionText}"
                      HorizontalAlignment="Left" />
            </StackPanel>
          </Border>
        </Grid>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Administration">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <Grid ColumnDefinitions="1*,1*" Margin="4,14" ColumnSpacing="14">
            <Border Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Text="Discover workload identities" FontSize="{StaticResource VaultFontSize20}" FontWeight="SemiBold" />
                <TextBlock Text="Select an enabled interactive identity on the Identities tab. Discovery uses only that explicit account; it never inherits Azure CLI, PowerShell, IDE, or terminal context." TextWrapping="Wrap" Opacity="0.75" />
                <Button Content="Authorize Microsoft Graph directory read"
                        Command="{Binding AuthorizeDirectoryReadCommand}"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="Authorize service principal directory discovery" />
                <TextBlock Text="Service-principal listing requests delegated Application.Read.All only after this explicit action. Microsoft Entra may require administrator consent. No Graph write permission is requested." TextWrapping="Wrap" Opacity="0.75" />
                <TextBlock Text="Exact subscription ID" />
                <TextBox Text="{Binding AdministrationSubscriptionId}"
                         PlaceholderText="00000000-0000-0000-0000-000000000000"
                         AutomationProperties.Name="Workload administration subscription ID" />
                <TextBlock Text="Exact Key Vault resource ID for permission assessment and optional provisioning preview" />
                <TextBox Text="{Binding AdministrationVaultResourceId}"
                         PlaceholderText="/subscriptions/.../providers/Microsoft.KeyVault/vaults/..."
                         AutomationProperties.Name="Exact Key Vault permission assessment scope" />
                <WrapPanel>
                  <Button Content="List managed identities"
                          Command="{Binding DiscoverManagedIdentitiesCommand}"
                          Margin="0,0,8,8" />
                  <Button Content="List service principals"
                          Command="{Binding DiscoverServicePrincipalsCommand}"
                          Margin="0,0,8,8" />
                </WrapPanel>
                <TextBlock Text="Customer-manageable candidates are shown by default. Microsoft first-party and infrastructure principals are excluded from this list."
                           TextWrapping="Wrap"
                           Opacity="0.75" />
                <Button Content="Assess selected identity permissions"
                        Command="{Binding AssessWorkloadIdentityPermissionsCommand}"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="Assess selected workload identity permissions at exact Key Vault" />
                <TextBlock Text="Assessment is read-only. It evaluates the selected administrator at exact resources and the workload identity's observable RBAC grants, inheritance, deny assignments, and conditions. Conditional or incomplete evidence never appears as allowed." TextWrapping="Wrap" Opacity="0.75" />
                <TextBlock Text="Visible workload identities" FontSize="{StaticResource VaultFontSize17}" FontWeight="SemiBold" />
                <ListBox ItemsSource="{Binding WorkloadIdentityCandidates}"
                         SelectedItem="{Binding SelectedWorkloadIdentityCandidate}"
                         MinHeight="360"
                         AutomationProperties.Name="Discovered workload identities and permission assessments">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Border BorderBrush="#344B43" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,0,0,6">
                        <StackPanel Spacing="3">
                          <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding IdentityType}" />
                          <TextBlock Text="{Binding State, StringFormat='State: {0}'}" />
                          <TextBlock Text="{Binding ClientId, StringFormat='Client ID: {0}'}" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding PrincipalId, StringFormat='Principal ID: {0}'}" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Scope, StringFormat='Scope: {0}'}" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding PermissionSummary}" TextWrapping="Wrap" Opacity="0.8" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
            </Border>

            <Border Grid.Column="1" Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Text="Preview workload provisioning" FontSize="{StaticResource VaultFontSize20}" FontWeight="SemiBold" />
                <Border Background="#3A2510" BorderBrush="#C98A2E" BorderThickness="1" CornerRadius="6" Padding="10">
                  <TextBlock Text="Preview only. This build cannot create identities, assign roles, attach identities, or change Key Vault. The independent security-review gate is still open." TextWrapping="Wrap" />
                </Border>
                <TextBlock Text="Identity name" />
                <TextBox Text="{Binding AdministrationIdentityName}"
                         AutomationProperties.Name="Proposed workload identity name" />
                <TextBlock Text="Resource group (managed identity only)" />
                <TextBox Text="{Binding AdministrationResourceGroup}"
                         AutomationProperties.Name="Proposed managed identity resource group" />
                <TextBlock Text="The optional exact Key Vault scope is entered in the discovery panel." />
                <TextBlock Text="Optional role definition resource ID" />
                <TextBox Text="{Binding AdministrationRoleDefinitionId}"
                         PlaceholderText="/subscriptions/.../providers/Microsoft.Authorization/roleDefinitions/..."
                         AutomationProperties.Name="Exact Key Vault role definition ID" />
                <TextBlock Text="Vault and role must be supplied together. A preview names every exact scope and never contains a credential or secret." TextWrapping="Wrap" Opacity="0.75" />
                <WrapPanel>
                  <Button Content="Preview managed identity"
                          Command="{Binding PreviewManagedIdentityCommand}"
                          Margin="0,0,8,8" />
                  <Button Content="Preview service principal"
                          Command="{Binding PreviewServicePrincipalCommand}"
                          Margin="0,0,8,8" />
                </WrapPanel>
                <TextBlock Text="Generated non-mutating plan" FontSize="{StaticResource VaultFontSize17}" FontWeight="SemiBold" />
                <TextBox Text="{Binding AdministrationPlanText}"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="300"
                         AutomationProperties.Name="Non-mutating workload provisioning plan" />
              </StackPanel>
            </Border>
          </Grid>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Workspaces">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid x:Name="WorkspaceGrid" ColumnDefinitions="1*,1*" RowDefinitions="*" Margin="4,14" ColumnSpacing="14" RowSpacing="14">
          <Border Classes="card">
            <StackPanel Spacing="10"><TextBlock Text="Workspaces" FontSize="{StaticResource VaultFontSize20}" FontWeight="SemiBold" />
              <ListBox ItemsSource="{Binding Workspaces}" SelectedItem="{Binding SelectedWorkspace}" MinHeight="300" AutomationProperties.Name="Vault Prospector workspaces"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" Margin="6" /></DataTemplate></ListBox.ItemTemplate></ListBox>
              <WrapPanel>
                <Button Content="Add selected vault" Command="{Binding AddSelectedVaultToWorkspaceCommand}" Margin="0,0,8,8" />
                <Button Content="Add selected identity" Command="{Binding AddSelectedIdentityToWorkspaceCommand}" Margin="0,0,8,8" />
                <Button Content="Add selected tenant" Command="{Binding AddSelectedTenantToWorkspaceCommand}" Margin="0,0,8,8" />
                <Button Content="Add selected subscription" Command="{Binding AddSelectedSubscriptionToWorkspaceCommand}" Margin="0,0,8,8" />
                <Button Content="Delete workspace" Command="{Binding RemoveWorkspaceCommand}" Margin="0,0,8,8" />
              </WrapPanel>
            </StackPanel>
          </Border>
          <Border x:Name="CreateWorkspaceCard" Grid.Column="1" Classes="card">
            <StackPanel Spacing="10"><TextBlock Text="Create workspace" FontSize="{StaticResource VaultFontSize20}" FontWeight="SemiBold" />
              <TextBlock Text="Group identities, tenants, subscriptions, and vaults without duplicating indexed data." TextWrapping="Wrap" />
              <TextBox Text="{Binding WorkspaceName}" PlaceholderText="Workspace name" AutomationProperties.Name="New workspace name" />
              <Button Classes="primary" Content="Create" Command="{Binding CreateWorkspaceCommand}" HorizontalAlignment="Left" />
              <TextBlock Text="Selected workspace cache policy" FontSize="{StaticResource VaultFontSize17}" FontWeight="SemiBold" Margin="0,14,0,0" />
              <CheckBox Content="Allow encrypted offline cache for this workspace"
                        IsChecked="{Binding WorkspaceCacheEnabled}"
                        IsEnabled="{Binding IsEnterpriseOfflineCacheAllowed}"
                        AutomationProperties.Name="Allow encrypted offline cache for selected workspace" />
              <TextBlock Text="Maximum cache lifetime (hours)" />
              <NumericUpDown Value="{Binding WorkspaceMaximumCacheHours}"
                             Minimum="1"
                             Maximum="168"
                             IsEnabled="{Binding IsEnterpriseOfflineCacheAllowed}"
                             AutomationProperties.Name="Selected workspace maximum cache lifetime in hours" />
              <CheckBox Content="Allow clipboard copy for this workspace"
                        IsChecked="{Binding WorkspaceAllowClipboard}"
                        IsEnabled="{Binding IsEnterpriseClipboardAllowed}"
                        AutomationProperties.Name="Allow clipboard copy for selected workspace" />
              <CheckBox Content="Require Windows verification (mandatory)"
                        IsChecked="True"
                        IsEnabled="False"
                        AutomationProperties.Name="Windows verification is mandatory for selected workspace" />
              <Button Content="Save selected workspace policy"
                      Command="{Binding SaveWorkspacePolicyCommand}"
                      AutomationProperties.Name="Save selected workspace cache policy"
                      HorizontalAlignment="Left" />
            </StackPanel>
          </Border>
        </Grid>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Browser fill">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="4,14" Spacing="14">
            <Border Classes="card"
                    AutomationProperties.Name="Browser fill machine policy status">
              <StackPanel Spacing="8">
                <TextBlock Text="Machine policy"
                           FontSize="{StaticResource VaultFontSize20}"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding BrowserPolicyStatus}"
                           TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite" />
                <TextBlock Text="A local mapping alone never authorizes fill. An administrator must also enable this exact destination, browser family, and field purpose in the protected installation policy."
                           TextWrapping="Wrap"
                           Opacity="0.75" />
              </StackPanel>
            </Border>

            <Border Classes="card"
                    BorderBrush="#DC6B6B"
                    BorderThickness="2"
                    IsVisible="{Binding IsBrowserFillPending}"
                    AutomationProperties.Name="Browser fill confirmation"
                    AutomationProperties.LiveSetting="Assertive">
              <StackPanel Spacing="10">
                <TextBlock Text="Confirm browser fill"
                           FontSize="{StaticResource VaultFontSize22}"
                           FontWeight="Bold" />
                <TextBlock Text="A browser asked for one mapped value. Confirm both the destination and source; approval still requires fresh Windows verification."
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding BrowserFillDestination, StringFormat='Destination: {0}'}"
                           TextWrapping="Wrap"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding BrowserFillPurpose, StringFormat='Field purpose: {0}'}"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding BrowserFillSource, StringFormat='Source: {0}'}"
                           TextWrapping="Wrap"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding BrowserFillStatus}"
                           TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite" />
                <WrapPanel>
                  <Button Classes="primary"
                          Content="Verify and fill once"
                          Command="{Binding ApproveBrowserFillCommand}"
                          AutomationProperties.Name="Verify with Windows and approve this one browser fill"
                          Margin="0,0,8,8" />
                  <Button Content="Deny"
                          Command="{Binding DenyBrowserFillCommand}"
                          AutomationProperties.Name="Deny this browser fill without retrieving a value"
                          Margin="0,0,8,8" />
                </WrapPanel>
              </StackPanel>
            </Border>

            <Grid ColumnDefinitions="1*,1*" ColumnSpacing="14">
              <Border Classes="card">
                <StackPanel Spacing="10">
                  <TextBlock Text="Origin-to-secret mappings"
                             FontSize="{StaticResource VaultFontSize20}"
                             FontWeight="SemiBold" />
                  <TextBlock Text="Mappings are encrypted locally and disabled by absence. Wildcards, HTTP pages, browser-internal pages, and private browser password databases are never supported."
                             TextWrapping="Wrap" />
                  <ListBox ItemsSource="{Binding BrowserFillMappings}"
                           SelectedItem="{Binding SelectedBrowserFillMapping}"
                           MinHeight="180"
                           AutomationProperties.Name="Browser fill mappings">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Summary}"
                                   Margin="6"
                                   TextWrapping="Wrap" />
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <WrapPanel>
                    <Button Content="Refresh mappings"
                            Command="{Binding RefreshBrowserIntegrationCommand}"
                            Margin="0,0,8,8" />
                    <Button Content="Remove selected mapping"
                            Command="{Binding RemoveBrowserMappingCommand}"
                            Margin="0,0,8,8" />
                  </WrapPanel>
                </StackPanel>
              </Border>

              <Border Grid.Column="1" Classes="card">
                <StackPanel Spacing="10">
                  <TextBlock Text="Map the selected secret"
                             FontSize="{StaticResource VaultFontSize20}"
                             FontWeight="SemiBold" />
                  <TextBlock Text="{Binding BrowserSelectedSource}"
                             TextWrapping="Wrap" />
                  <TextBlock Text="Top-frame HTTPS origin" />
                  <TextBox Text="{Binding BrowserTopOrigin}"
                           PlaceholderText="https://login.example.com"
                           AutomationProperties.Name="Approved browser top-frame HTTPS origin" />
                  <TextBlock Text="Target-frame HTTPS origin" />
                  <TextBox Text="{Binding BrowserFrameOrigin}"
                           PlaceholderText="https://login.example.com"
                           AutomationProperties.Name="Approved browser target-frame HTTPS origin" />
                  <TextBlock Text="Field purpose" />
                  <ComboBox ItemsSource="{Binding BrowserFieldPurposes}"
                            SelectedItem="{Binding SelectedBrowserFieldPurpose}"
                            AutomationProperties.Name="Approved browser field purpose" />
                  <CheckBox Content="Enable this exact mapping"
                            IsChecked="{Binding BrowserMappingEnabled}"
                            AutomationProperties.Name="Enable this exact browser mapping" />
                  <Button Classes="primary"
                          Content="Save selected secret mapping"
                          Command="{Binding SaveBrowserMappingCommand}"
                          AutomationProperties.Name="Save the selected secret and identity as this exact browser mapping"
                          HorizontalAlignment="Left" />
                </StackPanel>
              </Border>
            </Grid>

            <Border Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Text="Recent value-free browser audit"
                           FontSize="{StaticResource VaultFontSize20}"
                           FontWeight="SemiBold" />
                <TextBlock Text="Audit entries contain time, result, canonical origin, field purpose, and local identifiers—never a secret value."
                           TextWrapping="Wrap" />
                <ListBox ItemsSource="{Binding BrowserFillAudit}"
                         MinHeight="140"
                         AutomationProperties.Name="Recent browser fill audit">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Summary}"
                                 Margin="6"
                                 TextWrapping="Wrap" />
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="CyberArk"
               IsVisible="{Binding IsCyberArkPreviewEnabled}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="4,14" Spacing="14">
            <Border Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Text="CyberArk Privilege Cloud"
                           FontSize="{StaticResource VaultFontSize22}"
                           FontWeight="SemiBold" />
                <TextBlock Text="CyberArk is an independent source. Its service-user credential is protected with Windows DPAPI, its metadata is encrypted locally, and it is never merged into an Azure identity or permission model."
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding CyberArkStatus}"
                           TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite" />
              </StackPanel>
            </Border>

            <Grid ColumnDefinitions="0.85*,1.15*" ColumnSpacing="14">
              <Border Classes="card">
                <StackPanel Spacing="10">
                  <TextBlock Text="Profiles"
                             FontSize="{StaticResource VaultFontSize20}"
                             FontWeight="SemiBold" />
                  <ListBox ItemsSource="{Binding CyberArkProfiles}"
                           SelectedItem="{Binding SelectedCyberArkProfile}"
                           MinHeight="150"
                           AutomationProperties.Name="CyberArk profiles">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Margin="6" Spacing="2">
                          <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding PrivilegeCloudUrl}" FontSize="{StaticResource VaultFontSize11}" />
                          <TextBlock Text="{Binding AuthenticationState, StringFormat='State: {0}'}" />
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <WrapPanel>
                    <Button Content="New profile"
                            Command="{Binding NewCyberArkProfileCommand}"
                            Margin="0,0,8,8" />
                    <Button Content="Sync metadata"
                            Command="{Binding SynchronizeCyberArkCommand}"
                            Margin="0,0,8,8" />
                    <Button Content="Enable or disable"
                            Command="{Binding ToggleCyberArkProfileCommand}"
                            Margin="0,0,8,8" />
                  </WrapPanel>
                  <Separator />
                  <TextBlock Text="Revoke or permanently remove"
                             FontWeight="SemiBold" />
                  <TextBlock Text="Type REVOKE CYBERARK to fail closed and delete the local protected credential while retaining metadata, or REMOVE CYBERARK to also remove the profile and synchronized metadata. Value-free audit history is retained. External service-user revocation remains a CyberArk administrator action."
                             TextWrapping="Wrap"
                             Foreground="#FCA5A5" />
                  <TextBox Text="{Binding CyberArkRemoveConfirmation}"
                           PlaceholderText="REVOKE CYBERARK or REMOVE CYBERARK"
                           AutomationProperties.Name="CyberArk profile destructive action confirmation" />
                  <WrapPanel>
                    <Button Content="Revoke local CyberArk access"
                            Command="{Binding RevokeCyberArkProfileCommand}"
                            Background="#B45309"
                            Foreground="White"
                            Margin="0,0,8,8" />
                    <Button Content="Remove selected CyberArk profile"
                            Command="{Binding RemoveCyberArkProfileCommand}"
                            Background="#DC2626"
                            Foreground="White"
                            Margin="0,0,8,8" />
                  </WrapPanel>
                </StackPanel>
              </Border>

              <Border Grid.Column="1" Classes="card">
                <StackPanel Spacing="9">
                  <TextBlock Text="Connect or rotate a service-user credential"
                             FontSize="{StaticResource VaultFontSize20}"
                             FontWeight="SemiBold" />
                  <TextBlock Text="Profile name" />
                  <TextBox Text="{Binding CyberArkProfileName}"
                           AutomationProperties.Name="CyberArk profile name" />
                  <TextBlock Text="CyberArk Identity root URL" />
                  <TextBox Text="{Binding CyberArkIdentityUrl}"
                           PlaceholderText="https://tenant.id.cyberark.cloud/"
                           AutomationProperties.Name="CyberArk Identity root URL" />
                  <TextBlock Text="Privilege Cloud root URL" />
                  <TextBox Text="{Binding CyberArkPrivilegeCloudUrl}"
                           PlaceholderText="https://tenant.privilegecloud.cyberark.cloud/"
                           AutomationProperties.Name="CyberArk Privilege Cloud root URL" />
                  <TextBlock Text="Identity service user" />
                  <TextBox Text="{Binding CyberArkServiceUserName}"
                           PlaceholderText="service-user@example.com"
                           AutomationProperties.Name="CyberArk Identity service user" />
                  <TextBlock Text="Identity application name" />
                  <TextBox Text="{Binding CyberArkApplicationName}"
                           AutomationProperties.Name="CyberArk Identity application name" />
                  <TextBlock Text="Client credential" />
                  <TextBox Text="{Binding CyberArkClientCredential}"
                           PasswordChar="●"
                           AutomationProperties.Name="CyberArk client credential" />
                  <TextBlock Text="The credential is validated before replacement. It is cleared from this form and is never written to SQLCipher metadata or logs."
                             TextWrapping="Wrap"
                             Opacity="0.75" />
                  <Button Classes="primary"
                          Content="Validate and protect credential"
                          Command="{Binding ConnectCyberArkCommand}"
                          HorizontalAlignment="Left" />
                </StackPanel>
              </Border>
            </Grid>

            <Grid ColumnDefinitions="1*,1*" ColumnSpacing="14">
              <Border Classes="card">
                <StackPanel Spacing="10">
                  <TextBlock Text="Encrypted local account index"
                             FontSize="{StaticResource VaultFontSize20}"
                             FontWeight="SemiBold" />
                  <TextBox Text="{Binding CyberArkSearchText}"
                           PlaceholderText="Search account, safe, username, or address"
                           AutomationProperties.Name="Search CyberArk account metadata" />
                  <Button Content="Search local CyberArk metadata"
                          Command="{Binding SearchCyberArkCommand}"
                          HorizontalAlignment="Left" />
                  <ListBox ItemsSource="{Binding CyberArkAccounts}"
                           SelectedItem="{Binding SelectedCyberArkAccount}"
                           MinHeight="220"
                           AutomationProperties.Name="CyberArk accounts">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Summary}"
                                   Margin="6"
                                   TextWrapping="Wrap" />
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </StackPanel>
              </Border>

              <Border Grid.Column="1" Classes="card">
                <StackPanel Spacing="10">
                  <TextBlock Text="Explicit verified retrieval"
                             FontSize="{StaticResource VaultFontSize20}"
                             FontWeight="SemiBold" />
                  <TextBlock Text="{Binding SelectedCyberArkAccount.Summary, FallbackValue='Select an account.'}"
                             TextWrapping="Wrap"
                             FontWeight="SemiBold" />
                  <TextBlock Text="{Binding CyberArkPermissionSummary}"
                             TextWrapping="Wrap" />
                  <TextBlock Text="Secret version" />
                  <ComboBox ItemsSource="{Binding CyberArkVersions}"
                            SelectedItem="{Binding SelectedCyberArkVersion}"
                            AutomationProperties.Name="CyberArk secret version">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Summary}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Text="Non-sensitive business reason (sent to CyberArk audit)" />
                  <TextBox Text="{Binding CyberArkRetrievalReason}"
                           MaxLength="1000"
                           AcceptsReturn="True"
                           MinHeight="64"
                           AutomationProperties.Name="CyberArk retrieval reason" />
                  <TextBlock Text="{Binding CyberArkValuePreview}"
                             FontFamily="Consolas"
                             TextWrapping="Wrap"
                             AutomationProperties.Name="CyberArk protected value preview"
                             AutomationProperties.LiveSetting="Assertive" />
                  <WrapPanel>
                    <Button Classes="primary"
                            Content="Verify and reveal"
                            Command="{Binding RevealCyberArkCommand}"
                            Margin="0,0,8,8" />
                    <Button Content="Verify and copy"
                            Command="{Binding CopyCyberArkCommand}"
                            Margin="0,0,8,8" />
                  </WrapPanel>
                </StackPanel>
              </Border>
            </Grid>

            <Grid ColumnDefinitions="1*,1*" ColumnSpacing="14">
              <Border Classes="card">
                <StackPanel Spacing="10">
                  <TextBlock Text="Safes"
                             FontSize="{StaticResource VaultFontSize20}"
                             FontWeight="SemiBold" />
                  <ListBox ItemsSource="{Binding CyberArkSafes}"
                           MinHeight="140"
                           AutomationProperties.Name="CyberArk safes">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Summary}"
                                   Margin="6"
                                   TextWrapping="Wrap" />
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Classes="card">
                <StackPanel Spacing="10">
                  <TextBlock Text="Value-free local audit"
                             FontSize="{StaticResource VaultFontSize20}"
                             FontWeight="SemiBold" />
                  <TextBlock Text="CyberArk remains the authoritative server-side audit source. Local entries record verification, operation, profile/account context, version, and result—never credentials, tokens, reasons, or values."
                             TextWrapping="Wrap" />
                  <ListBox ItemsSource="{Binding CyberArkAudit}"
                           MinHeight="140"
                           AutomationProperties.Name="CyberArk local audit events">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Summary}"
                                   Margin="6"
                                   TextWrapping="Wrap" />
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </StackPanel>
              </Border>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Settings">
        <ScrollViewer Margin="4,14"><Border Classes="card" MaxWidth="700" HorizontalAlignment="Left">
          <StackPanel Spacing="12">
            <TextBlock Text="Security settings" FontSize="{StaticResource VaultFontSize22}" FontWeight="SemiBold" />
            <Border Background="#10243A"
                    BorderBrush="#4B84B8"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10"
                    AutomationProperties.Name="Machine-managed enterprise policy status">
              <StackPanel Spacing="6">
                <TextBlock Text="Machine-managed enterprise policy"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding EnterprisePolicyStatus}"
                           TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite" />
                <TextBlock Text="Administrators configure this read-only policy under HKLM. Invalid or unreadable policy fails closed for governed providers, identities, clipboard, and offline values."
                           TextWrapping="Wrap"
                           Opacity="0.75" />
              </StackPanel>
            </Border>
            <CheckBox Content="Enable encrypted offline value cache"
                      IsChecked="{Binding OfflineCacheEnabled}"
                      IsEnabled="{Binding IsEnterpriseOfflineCacheAllowed}" />
            <TextBlock Text="Offline values are disabled by default, encrypted separately, and require Windows Hello." TextWrapping="Wrap" Opacity="0.75" />
            <TextBlock Text="Maximum cache lifetime (hours)" /><NumericUpDown Value="{Binding MaximumCacheHours}" Minimum="1" Maximum="168" Increment="1" IsEnabled="{Binding IsEnterpriseOfflineCacheAllowed}" AutomationProperties.Name="Maximum offline cache lifetime in hours" />
            <TextBlock Text="Clipboard clear delay (seconds)" /><NumericUpDown Value="{Binding ClipboardClearSeconds}" Minimum="5" Maximum="300" Increment="5" IsEnabled="{Binding IsEnterpriseClipboardAllowed}" AutomationProperties.Name="Clipboard clear delay in seconds" />
            <TextBlock Text="When the main window closes" FontWeight="SemiBold" />
            <ComboBox ItemsSource="{Binding CloseBehaviors}"
                      SelectedItem="{Binding SelectedCloseBehavior}"
                      AutomationProperties.Name="Main window close behavior" />
            <CheckBox Content="Allow metadata-only background synchronization every 15 minutes"
                      IsChecked="{Binding BackgroundMetadataSyncEnabled}"
                      AutomationProperties.Name="Allow metadata-only synchronization while locked in notification area" />
            <TextBlock Text="Background synchronization is opt-in, never retrieves values, runs only while the window is hidden, network is available, and Windows confirms external power, and stops or reports interaction-required when Azure cannot authenticate silently." TextWrapping="Wrap" Opacity="0.75" />
            <WrapPanel><Button Classes="primary" Content="Save settings" Command="{Binding SaveSettingsCommand}" Margin="0,0,8,8" /><Button Content="Purge selected vault" Command="{Binding PurgeSelectedVaultCacheCommand}" Margin="0,0,8,8" /><Button Content="Purge selected workspace" Command="{Binding PurgeSelectedWorkspaceCacheCommand}" Margin="0,0,8,8" /><Button Content="Purge all offline values" Command="{Binding PurgeAllCachedValuesCommand}" Margin="0,0,8,8" /></WrapPanel>
            <Separator Margin="0,8" />
            <TextBlock Text="Recovery archive retention" FontSize="{StaticResource VaultFontSize18}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding RecoveryArchiveStatus}" TextWrapping="Wrap" Opacity="0.8" AutomationProperties.LiveSetting="Polite" />
            <ListBox ItemsSource="{Binding RecoveryArchives}"
                     SelectedItem="{Binding SelectedRecoveryArchive}"
                     MinHeight="72"
                     MaxHeight="180"
                     AutomationProperties.Name="Retained local recovery archives">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:LocalRecoveryArchiveRow">
                  <StackPanel Margin="4,6" Spacing="2">
                    <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Id}" FontFamily="Consolas" FontSize="{StaticResource VaultFontSize11}" TextWrapping="Wrap" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Button Content="Refresh recovery archives"
                    Command="{Binding RefreshRecoveryArchivesCommand}"
                    HorizontalAlignment="Left"
                    AutomationProperties.Name="Refresh retained local recovery archives" />
            <StackPanel Spacing="8">
              <TextBlock Text="Deleting an archive is permanent. It can remove the only matched-key recovery copy or support evidence. Select one, type DELETE ARCHIVE exactly, and complete fresh Windows verification." TextWrapping="Wrap" Foreground="#FCA5A5" />
              <TextBox Text="{Binding RecoveryArchiveDeleteConfirmation}"
                       PlaceholderText="DELETE ARCHIVE"
                       AutomationProperties.Name="Recovery archive deletion confirmation" />
              <Button Content="Verify and permanently delete selected archive"
                      Command="{Binding DeleteSelectedRecoveryArchiveCommand}"
                      Background="#DC2626"
                      Foreground="White"
                      HorizontalAlignment="Left"
                      AutomationProperties.Name="Verify and permanently delete selected recovery archive" />
            </StackPanel>
            <TextBlock Text="Telemetry is disabled. Logs contain no tokens, values, usernames, vault names, or object names." TextWrapping="Wrap" FontSize="{StaticResource VaultFontSize11}" Opacity="0.7" />
          </StackPanel>
        </Border></ScrollViewer>
      </TabItem>

      <TabItem Header="About">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Border Classes="card" Margin="4,14" MaxWidth="700" HorizontalAlignment="Left" VerticalAlignment="Top">
          <StackPanel Spacing="10"><TextBlock Text="{Binding VersionLabel}" FontSize="{StaticResource VaultFontSize24}" FontWeight="SemiBold" />
            <TextBlock Text="A local-first Azure Key Vault discovery, search, and secure retrieval desktop application." TextWrapping="Wrap" />
            <TextBlock Text="This preview never creates role assignments, rotates secrets, or silently caches values. Azure remains the source of truth." TextWrapping="Wrap" />
            <TextBlock Text="Mobile apps are intentionally deferred and tracked on the roadmap." TextWrapping="Wrap" Opacity="0.75" />
          </StackPanel>
        </Border>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <Border Grid.Row="3" Background="{DynamicResource VaultColorSurface}" BorderBrush="{DynamicResource VaultColorLine}" BorderThickness="0,1,0,0" Padding="18,10">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
        <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />
        <ProgressBar Grid.Column="1" IsIndeterminate="True" IsVisible="{Binding IsBusy}" Width="120" AutomationProperties.Name="Operation in progress" />
        <Button Grid.Column="2" Content="Cancel operation" Command="{Binding CancelOperationCommand}" IsVisible="{Binding IsBusy}" AutomationProperties.Name="Cancel the active operation" />
      </Grid>
    </Border>
  </Grid>
</Window>
