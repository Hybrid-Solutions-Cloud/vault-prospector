<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="VaultProspector.App.App"
             xmlns:local="using:VaultProspector.App"
             RequestedThemeVariant="Default">

    <Application.Resources>
        <SolidColorBrush x:Key="VaultColorCanvas">#F4F1EA</SolidColorBrush>
        <SolidColorBrush x:Key="VaultColorSurface">#FFFDF8</SolidColorBrush>
        <SolidColorBrush x:Key="VaultColorSurfaceAlt">#EEE9DF</SolidColorBrush>
        <SolidColorBrush x:Key="VaultColorInk">#25231F</SolidColorBrush>
        <SolidColorBrush x:Key="VaultColorMuted">#6F6A61</SolidColorBrush>
        <SolidColorBrush x:Key="VaultColorLine">#D4CDC0</SolidColorBrush>
        <SolidColorBrush x:Key="VaultColorLineStrong">#A99E8D</SolidColorBrush>
        <SolidColorBrush x:Key="VaultColorAccent">#9A412B</SolidColorBrush>
        <SolidColorBrush x:Key="VaultColorAccentStrong">#7B3020</SolidColorBrush>
        <SolidColorBrush x:Key="VaultColorAccentSoft">#F2DFD8</SolidColorBrush>
        <SolidColorBrush x:Key="VaultColorGood">#27715B</SolidColorBrush>
        <SolidColorBrush x:Key="VaultColorGoodSoft">#DEEEE8</SolidColorBrush>
        <SolidColorBrush x:Key="VaultColorWarning">#A26118</SolidColorBrush>
        <SolidColorBrush x:Key="VaultColorWarningSoft">#F7EAD5</SolidColorBrush>
        <SolidColorBrush x:Key="VaultColorDanger">#A33E3E</SolidColorBrush>
        <SolidColorBrush x:Key="VaultColorDangerSoft">#FBE5E5</SolidColorBrush>
        <SolidColorBrush x:Key="VaultColorNavigation">#EEE8DD</SolidColorBrush>
        <SolidColorBrush x:Key="VaultColorContext">#E7DFD2</SolidColorBrush>
        <SolidColorBrush x:Key="VaultColorHeader">#2C3737</SolidColorBrush>
        <Thickness x:Key="VaultCardPadding">16</Thickness>
        <x:Double x:Key="VaultFontSize11">11</x:Double>
        <x:Double x:Key="VaultFontSize12">12</x:Double>
        <x:Double x:Key="VaultFontSize14">14</x:Double>
        <x:Double x:Key="VaultFontSize16">16</x:Double>
        <x:Double x:Key="VaultFontSize17">17</x:Double>
        <x:Double x:Key="VaultFontSize18">18</x:Double>
        <x:Double x:Key="VaultFontSize20">20</x:Double>
        <x:Double x:Key="VaultFontSize22">22</x:Double>
        <x:Double x:Key="VaultFontSize24">24</x:Double>
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme DensityStyle="Compact" />
        <Style Selector="Window">
            <Setter Property="FontSize" Value="{DynamicResource VaultFontSize14}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="Foreground" Value="{DynamicResource VaultColorInk}" />
        </Style>
        <Style Selector="NumericUpDown">
            <Setter Property="MinHeight" Value="26" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource VaultColorAccent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="{DynamicResource VaultColorAccentStrong}" />
        </Style>
        <Style Selector="TabControl.product-shell">
            <Setter Property="TabStripPlacement" Value="Left" />
            <Setter Property="Background" Value="{DynamicResource VaultColorCanvas}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TabControl.product-shell TabItem">
            <Setter Property="MinWidth" Value="205" />
            <Setter Property="MaxWidth" Value="205" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="18,11" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{DynamicResource VaultColorMuted}" />
            <Setter Property="Background" Value="{DynamicResource VaultColorNavigation}" />
            <Setter Property="BorderThickness" Value="5,0,0,0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="FontSize" Value="{DynamicResource VaultFontSize16}" />
        </Style>
        <Style Selector="TabControl.product-shell TabItem:selected">
            <Setter Property="Background" Value="{DynamicResource VaultColorAccent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource VaultColorAccentStrong}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Window.high-contrast TextBox">
            <Setter Property="PlaceholderForeground" Value="{DynamicResource TextControlForeground}" />
        </Style>
        <Style Selector="Window.high-contrast ComboBox:focus-visible /template/ Border#HighlightBackground">
            <Setter Property="Background" Value="{DynamicResource TextControlBackground}" />
        </Style>
        <Style Selector="Window.high-contrast ComboBox:focus-visible /template/ ContentControl#ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource TextControlForeground}" />
        </Style>
        <Style Selector="Window.high-contrast ComboBox:focus-visible /template/ TextBlock#PlaceholderTextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextControlForeground}" />
        </Style>
        <Style Selector="Window.high-contrast ComboBox:focus-visible /template/ PathIcon#DropDownGlyph">
            <Setter Property="Foreground" Value="{DynamicResource TextControlForeground}" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource VaultColorSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource VaultColorLine}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="{StaticResource VaultCardPadding}" />
        </Style>
        <Style Selector="Border.atlas-panel">
            <Setter Property="Background" Value="{DynamicResource VaultColorSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource VaultColorLine}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="18" />
        </Style>
        <Style Selector="Border.atlas-callout">
            <Setter Property="Background" Value="#EEF4F1" />
            <Setter Property="BorderBrush" Value="{DynamicResource VaultColorGood}" />
            <Setter Property="BorderThickness" Value="4,0,0,0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style Selector="Border.atlas-warning">
            <Setter Property="Background" Value="{DynamicResource VaultColorWarningSoft}" />
            <Setter Property="BorderBrush" Value="{DynamicResource VaultColorWarning}" />
            <Setter Property="BorderThickness" Value="4,0,0,0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style Selector="TextBlock.screen-eyebrow">
            <Setter Property="Foreground" Value="{DynamicResource VaultColorAccentStrong}" />
            <Setter Property="FontSize" Value="{DynamicResource VaultFontSize11}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LetterSpacing" Value="1.4" />
        </Style>
        <Style Selector="TextBlock.screen-title">
            <Setter Property="FontFamily" Value="Georgia" />
            <Setter Property="FontSize" Value="31" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#171612" />
        </Style>
        <Style Selector="TextBlock.screen-description">
            <Setter Property="Foreground" Value="{DynamicResource VaultColorMuted}" />
            <Setter Property="FontSize" Value="{DynamicResource VaultFontSize16}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="{DynamicResource VaultFontSize18}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.field-label">
            <Setter Property="FontSize" Value="{DynamicResource VaultFontSize12}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="TextBlock.nav-caption">
            <Setter Property="Foreground" Value="{DynamicResource VaultColorMuted}" />
            <Setter Property="FontSize" Value="{DynamicResource VaultFontSize11}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LetterSpacing" Value="1.2" />
        </Style>
        <Style Selector="TextBox.atlas-search">
            <Setter Property="MinHeight" Value="52" />
            <Setter Property="FontSize" Value="{DynamicResource VaultFontSize16}" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="BorderBrush" Value="{DynamicResource VaultColorLineStrong}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Background" Value="{DynamicResource VaultColorSurface}" />
        </Style>
        <Style Selector="ComboBox.atlas-filter">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Background" Value="{DynamicResource VaultColorSurface}" />
        </Style>
        <Style Selector="ListBox.atlas-list">
            <Setter Property="Background" Value="{DynamicResource VaultColorSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource VaultColorLine}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Expander.atlas-expander">
            <Setter Property="Background" Value="{DynamicResource VaultColorSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource VaultColorLine}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8" />
        </Style>
    </Application.Styles>
</Application>
