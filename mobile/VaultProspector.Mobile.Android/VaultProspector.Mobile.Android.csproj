<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>31</SupportedOSPlatformVersion>
    <ApplicationId>cloud.hybridsolutions.vaultprospector</ApplicationId>
    <ApplicationTitle>Vault Prospector</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <AndroidPackageFormat>aab</AndroidPackageFormat>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <RuntimeIdentifier>android-arm64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" />
    <PackageReference Include="Microsoft.Identity.Client" />
    <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VaultProspector.Mobile\VaultProspector.Mobile.csproj" />
    <ProjectReference Include="..\VaultProspector.Mobile.Autofill\VaultProspector.Mobile.Autofill.csproj" />
    <ProjectReference Include="..\VaultProspector.Mobile.Core\VaultProspector.Mobile.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\MobileMsalIdentityProvider.cs">
      <Link>Identity\MobileMsalIdentityProvider.cs</Link>
    </Compile>
  </ItemGroup>

</Project>
