<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>18.0</SupportedOSPlatformVersion>
    <ApplicationId>cloud.hybridsolutions.vaultprospector</ApplicationId>
    <ApplicationTitle>Vault Prospector</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <RuntimeIdentifiers>ios-arm64;iossimulator-arm64</RuntimeIdentifiers>
    <CodesignEntitlements>Entitlements.plist</CodesignEntitlements>
    <!-- Keep package-internal trim warnings visible while project warnings remain errors. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IL2104</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.iOS" />
    <PackageReference Include="Microsoft.Identity.Client" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VaultProspector.Mobile\VaultProspector.Mobile.csproj" />
    <ProjectReference Include="..\VaultProspector.Mobile.Core\VaultProspector.Mobile.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\MobileMsalIdentityProvider.cs">
      <Link>Identity\MobileMsalIdentityProvider.cs</Link>
    </Compile>
    <BundleResource Include="PrivacyInfo.xcprivacy"
                    LogicalName="PrivacyInfo.xcprivacy" />
  </ItemGroup>
</Project>
