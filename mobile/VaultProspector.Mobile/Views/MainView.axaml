<UserControl
    x:Class="VaultProspector.Mobile.Views.MainView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:VaultProspector.Mobile.ViewModels"
    d:DesignHeight="844"
    d:DesignWidth="390"
    x:DataType="vm:MainViewModel"
    mc:Ignorable="d">
  <Grid Background="#08111E">
    <ScrollViewer>
      <StackPanel Margin="24" Spacing="20">
        <StackPanel Spacing="4">
          <TextBlock
              FontSize="14"
              Foreground="#7DD3FC"
              Text="VAULT PROSPECTOR" />
          <TextBlock
              FontSize="30"
              FontWeight="SemiBold"
              Text="Your vaults, in reach" />
          <TextBlock
              Foreground="#A9B8CC"
              Text="{Binding PlatformLabel}" />
        </StackPanel>

        <Border
            Padding="18"
            Background="#101E30"
            CornerRadius="14">
          <StackPanel Spacing="14">
            <TextBlock
                FontSize="20"
                FontWeight="SemiBold"
                Text="{Binding IsLocked, StringFormat='Session locked: {0}'}" />
            <TextBlock
                Text="{Binding StatusText}"
                TextWrapping="Wrap" />
            <Button
                AutomationProperties.Name="Unlock Vault Prospector"
                Command="{Binding UnlockCommand}"
                Content="Unlock with device security"
                IsVisible="{Binding IsLocked}"
                MinHeight="48" />
            <Button
                AutomationProperties.Name="Lock Vault Prospector"
                Command="{Binding LockCommand}"
                Content="Lock now"
                IsVisible="{Binding !IsLocked}"
                MinHeight="48" />
          </StackPanel>
        </Border>

        <Border
            Padding="18"
            Background="#101E30"
            CornerRadius="14"
            IsVisible="{Binding !IsLocked}">
          <StackPanel Spacing="12">
            <TextBlock
                FontSize="20"
                FontWeight="SemiBold"
                Text="Search encrypted metadata" />
            <TextBox
                AutomationProperties.Name="Search vault metadata"
                MinHeight="48"
                Text="{Binding SearchText}"
                PlaceholderText="Secret, vault, tenant, or tag" />
            <TextBlock
                Foreground="#A9B8CC"
                Text="Metadata stays encrypted locally. Values are fetched only after an explicit action and fresh device verification."
                TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBox
                  AutomationProperties.Name="Identity label"
                  MinHeight="48"
                  PlaceholderText="Identity label (optional)"
                  Text="{Binding IdentityLabel}"
                  Width="220" />
              <Button
                  AutomationProperties.Name="Connect Microsoft identity"
                  Command="{Binding ConnectIdentityCommand}"
                  Content="Connect"
                  MinHeight="48" />
            </StackPanel>
            <ComboBox
                AutomationProperties.Name="Connected identity"
                ItemsSource="{Binding Identities}"
                MinHeight="48"
                SelectedItem="{Binding SelectedIdentity}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding DisplayName}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button
                  AutomationProperties.Name="Synchronize selected identity"
                  Command="{Binding SynchronizeCommand}"
                  Content="Synchronize"
                  MinHeight="48" />
              <Button
                  AutomationProperties.Name="Search metadata"
                  Command="{Binding SearchCommand}"
                  Content="Search"
                  MinHeight="48" />
            </StackPanel>
            <ListBox
                AutomationProperties.Name="Vault metadata results"
                ItemsSource="{Binding Results}"
                MaxHeight="300"
                MinHeight="120"
                SelectedItem="{Binding SelectedResult}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="4" Spacing="2">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Item.ProviderObjectName}" />
                    <TextBlock
                        Foreground="#A9B8CC"
                        Text="{Binding Vault.Name, StringFormat='Vault: {0}'}" />
                    <TextBlock
                        Foreground="#A9B8CC"
                        Text="{Binding IdentityDisplayName, StringFormat='Identity: {0}'}" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button
                  AutomationProperties.Name="Reveal selected secret"
                  Command="{Binding RevealCommand}"
                  Content="Reveal"
                  MinHeight="48" />
              <Button
                  AutomationProperties.Name="Copy selected secret"
                  Command="{Binding CopyCommand}"
                  Content="Copy 30s"
                  MinHeight="48" />
            </StackPanel>
            <Border
                Padding="12"
                Background="#07101B"
                CornerRadius="8"
                IsVisible="{Binding HasRevealedValue}">
              <TextBlock
                  AutomationProperties.Name="Temporarily revealed secret value"
                  FontFamily="Consolas"
                  Text="{Binding RevealedValue}"
                  TextWrapping="Wrap" />
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
